// --- Filter 1: HTF FVG delivery ---
requireHtfFvg = input.bool(false, "Require Delivery from HTF FVG", tooltip="Optional quality filter. An existing Unicorn setup is only confirmed when price is delivering from an unmitigated higher-timeframe FVG in the same direction. This is ADDITIONAL to Unicorn Mode's LTF FVG requirement, it does not replace it.", group=GRP_CONF)
htfFvgTfMode = input.string("Automatic", "HTF FVG Timeframe Mode", options=["Automatic", "Manual"], tooltip="Automatic uses Liquidity Source B's resolved timeframe. Manual uses the timeframe below.", group=GRP_CONF, active=requireHtfFvg)
htfFvgTf1Enable = input.bool(true, "HTF FVG TF 1", inline="conf_tf1", tooltip="Enable the first HTF FVG timeframe.", group=GRP_CONF, active=requireHtfFvg)
htfFvgTf1 = input.timeframe("15", "", inline="conf_tf1", tooltip="First HTF FVG timeframe (used when Mode is Manual). In Automatic mode this slot follows Liquidity Source B.", group=GRP_CONF, active=requireHtfFvg and htfFvgTf1Enable and htfFvgTfMode == "Manual")
htfFvgTf2Enable = input.bool(true, "HTF FVG TF 2", inline="conf_tf2", tooltip="Enable the second HTF FVG timeframe.", group=GRP_CONF, active=requireHtfFvg)
htfFvgTf2 = input.timeframe("60", "", inline="conf_tf2", tooltip="Second HTF FVG timeframe (used when Mode is Manual). In Automatic mode this slot follows Liquidity Source C.", group=GRP_CONF, active=requireHtfFvg and htfFvgTf2Enable and htfFvgTfMode == "Manual")
htfFvgTf3Enable = input.bool(true, "HTF FVG TF 3", inline="conf_tf3", tooltip="Enable the third HTF FVG timeframe.", group=GRP_CONF, active=requireHtfFvg)
htfFvgTf3 = input.timeframe("240", "", inline="conf_tf3", tooltip="Third HTF FVG timeframe (used when Mode is Manual). In Automatic mode this slot follows Liquidity Source D.", group=GRP_CONF, active=requireHtfFvg and htfFvgTf3Enable and htfFvgTfMode == "Manual")
htfFvgConfluenceMode = input.string("Any Timeframe", "Require Delivery From", options=["Any Timeframe", "All Enabled Timeframes"], tooltip="Any Timeframe: delivery from a valid HTF FVG on ANY enabled timeframe qualifies the setup. All Enabled Timeframes: EVERY enabled timeframe must have a valid delivering FVG - a much tighter filter. If all three timeframe slots are disabled the filter fails closed (no setups qualify).", group=GRP_CONF, active=requireHtfFvg)
htfFvgDelivery = input.string("Touch", "Delivery Requirement", options=["Touch", "Enter", "50%"], tooltip="Touch: the bar range overlaps any part of the gap, boundary included. Enter: the bar range overlaps the gap INTERIOR, so a boundary-only kiss does not qualify. 50%: the bar range must straddle the gap's 50% equilibrium level.", group=GRP_CONF, active=requireHtfFvg)
htfFvgMitigation = input.string("Close Through", "FVG Mitigation Rule", options=["Close Through", "Wick Through"], tooltip="Close Through: the gap dies when a chart bar closes beyond its far boundary. Wick Through: a wick beyond the far boundary is enough. A mitigated gap can never qualify a setup.", group=GRP_CONF, active=requireHtfFvg)
htfFvgMaxAge = input.int(50, "Max HTF FVG Age (HTF Bars)", minval=1, maxval=500, tooltip="Maximum age of a valid HTF FVG, counted in HTF BARS (not chart bars).", group=GRP_CONF, active=requireHtfFvg)
htfFvgMinAtr = input.float(0.0, "Min HTF FVG Size (x HTF ATR)", minval=0.0, step=0.1, tooltip="Optional minimum gap height as a multiple of the CONFIRMED HTF ATR(14) at formation. 0 disables the check.", group=GRP_CONF, active=requireHtfFvg)
showHtfFvgs = input.bool(false, "Show HTF FVGs", tooltip="Draw boxes for tracked HTF FVGs. Off by default to keep the chart clean.", group=GRP_CONF)
htfFvgBullColor = input.color(color.new(#089981, 88), "HTF FVG Colors", inline="conf_fvg_col", tooltip="Bullish HTF FVG box color.", group=GRP_CONF, active=showHtfFvgs)
htfFvgBearColor = input.color(color.new(#f23645, 88), "", inline="conf_fvg_col", tooltip="Bearish HTF FVG box color.", group=GRP_CONF, active=showHtfFvgs)

// --- Filter 2: Session liquidity delivery ---
requireSessionLiq = input.bool(false, "Session Liquidity", tooltip="Optional quality filter. Bullish setups require a swept session LOW, bearish setups a swept session HIGH, inside the validity window below. Completely separate from the existing HTF liquidity engine.", group=GRP_CONF)
sess1Enable = input.bool(true, "Session 1", inline="cs1", tooltip="Track this session's high and low as liquidity.", group=GRP_CONF, active=requireSessionLiq)
sess1Time = input.session("2000-0000", "", inline="cs1", tooltip="Session 1 range. Uses the chart timezone, or the Time Filter's custom timezone when that is enabled.", group=GRP_CONF, active=requireSessionLiq and sess1Enable)
sess1Name = input.string("Asia", "", inline="cs1", tooltip="Name for session 1 (used in the session liquidity labels).", group=GRP_CONF, active=requireSessionLiq and sess1Enable)
sess2Enable = input.bool(true, "Session 2", inline="cs2", tooltip="Track this session's high and low as liquidity.", group=GRP_CONF, active=requireSessionLiq)
