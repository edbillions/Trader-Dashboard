//@version=6
indicator("Unicorn Model", shorttitle="UM", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ========================================
// USER DEFINED TYPES
// ========================================
type HTFLevel
    string tfLabel      // e.g. "4H", "1H"
    string levelType    // "Swing" or "OHLC"
    bool isHigh         // true = High / false = Low
    float price
    int startBar
    bool isSwept
    int sweepBar
    string labelText

type Setup
    string dir                // "BULL" or "BEAR"
    int sweepIndex            // Bar index of the sweep extreme
    float sweepExtreme        // Highest high or lowest low of the sweep leg
    float sweptLevel          // The HTF liquidity level that was swept
    int sweptLevelStartBar   // Bar index when the swept level was formed
    int breakerStartIdx       // Start bar index of the breaker candles series
    int breakerEndIdx         // End bar index of the breaker candles series
    float breakerTop          // Max high of the breaker candles series
    float breakerBottom       // Min low of the breaker candles series
    bool isConfirmed          // Confirmed yet?
    int confIndex             // Bar index of confirmation
    float entryPrice          // Price at confirmation (close)
    float invalidationPrice   // Invalidation level
    bool isInvalidated        // Has it been invalidated?
    bool isTargetHit          // Has target been hit?
    line levelLine            // Dotted level line drawn when setup confirmed
    label levelLabel          // Text label at origin of level line
    box breakerBox            // Box drawing for breaker
    box fvgBox                // Box drawing for FVG
    box htfFvgOriginBox       // Box drawing for the HTF FVG this setup delivered from (static, not extended)
    label htfFvgOriginLabel   // Small edge label on the HTF FVG origin box, e.g. "H1 FVG"
    line[] targetLines        // Array of lines for target projections
    label[] targetLabels      // Array of labels for targets
    label setupLabel          // Monospaced text label (+Unicorn / -Breaker)
    bool gradeHtfFvg          // Setup Grade: did this setup deliver from a tapped HTF FVG?
    bool gradeLtfFvg          // Setup Grade: same as hasFvg — true "Unicorn" vs plain "Breaker"
    bool gradeVolume          // Setup Grade: breaker's avg volume >= volumeMult x recent average?
    bool gradeSmt             // Setup Grade: did the comparison symbol fail to sweep its own extreme?

// HTF FVG Context: a single higher-timeframe Fair Value Gap. Stays in activeHtfFvgs even after
// becoming mitigated (fully broken through) as long as it was tapped — a liquidity-sweep leg
// commonly blows straight through a gap on its way to the sweep, and that tap should still count
// as "delivering from" the HTF FVG. Only untapped, never-touched gaps get pruned on mitigation.
type HTFFvg
    string tfLabel    // Friendly label of the HTF it was found on, e.g. "M15", "H1"
    bool isBull       // true = bullish (discount) gap, false = bearish (premium) gap
    float top
    float bottom
    int startBar      // Chart bar_index at time of registration (visual anchor only)
    bool tapped        // Has price ever wicked into this gap? Set once, never cleared.
    bool mitigated      // Has price fully broken through it? Set once, never cleared.

// ========================================
// GLOBAL STATE ARRAYS (Defined before functions)
// ========================================
var HTFLevel[] activeHTFLevels = array.new<HTFLevel>()
var Setup[] activeSetups = array.new<Setup>()

// HTF FVG Context state
var HTFFvg[] activeHtfFvgs = array.new<HTFFvg>()
var int lastHtfFvgAnchorTimeA = na
var int lastHtfFvgAnchorTimeB = na
var int lastHtfFvgAnchorTimeC = na
var int lastHtfFvgAnchorTimeD = na

// HTF FVG Context: accumulated closed-HTF-bar highs/lows per slot, oldest-first (index n-1 is
// the most recently closed bar). f_scanHtfFvgFromArrays reads these in the main chart context.
var float[] htfFvgHighsA = array.new_float()
var float[] htfFvgLowsA = array.new_float()
var float[] htfFvgHighsB = array.new_float()
var float[] htfFvgLowsB = array.new_float()
var float[] htfFvgHighsC = array.new_float()
var float[] htfFvgLowsC = array.new_float()
var float[] htfFvgHighsD = array.new_float()
var float[] htfFvgLowsD = array.new_float()

// HTF FVG Context: last-seen scan result per slot/direction, so registration only pushes a new
// HTFFvg when the security-side scan actually surfaces a different gap (not the same one again).
var float lastBullTopA = na
var float lastBullBottomA = na
var float lastBearTopA = na
var float lastBearBottomA = na

var float lastBullTopB = na
var float lastBullBottomB = na
var float lastBearTopB = na
var float lastBearBottomB = na

var float lastBullTopC = na
var float lastBullBottomC = na
var float lastBearTopC = na
var float lastBearBottomC = na

var float lastBullTopD = na
var float lastBullBottomD = na
var float lastBearTopD = na
var float lastBearBottomD = na

// ========================================
// GLOBAL USER FUNCTIONS (Defined next)
// ========================================

// Convert TF to label dynamically using seconds
f_getTFLabel(string tf) =>
    seconds = timeframe.in_seconds(tf)
    res = ""
    if seconds < 60
        res := str.tostring(seconds) + "S"
    else if (seconds / 60) < 60
        res := str.tostring(math.round(seconds / 60)) + "m"
    else if (seconds / 3600) < 24
        res := str.tostring(math.round(seconds / 3600)) + "H"
    else if (seconds / 86400) < 7
        res := str.tostring(math.round(seconds / 86400)) + "D"
    else if (seconds / 86400) < 30
        res := str.tostring(math.round(seconds / 604800)) + "W"
    else
        res := str.tostring(math.round(seconds / 2592000)) + "M"
    res

// Resolve standard TradingView timeframe strings corresponding to hierarchy indexes
f_getHTFByVal(idx) =>
    switch idx
        0 => "5"
        1 => "15"
        2 => "30"
        3 => "60"
        4 => "150"
        5 => "240"
        6 => "1D"
        7 => "720"
        8 => "1D"
        9 => "2D"
        10 => "W"
        11 => "4D"
        12 => "W"
        13 => "15D"
        14 => "45D"
        15 => "15W"
        16 => "15M"
        => "60"

// Automatic HTF selection mapping (Mirroring Chronology Hierarchy)
getAutoHTFs() =>
    int tf = timeframe.in_seconds()
    int k = 0
    if tf <= 15           // 15S and below → 5m
        k := 0
    else if tf <= 60      // 1m and below → 15m
        k := 1
    else if tf <= 180     // 3m and below → 30m
        k := 2
    else if tf <= 300     // 5m and below → 1H
        k := 3
    else if tf <= 600     // 10m and below → 2.5H (150m)
        k := 4
    else if tf <= 900     // 15m and below → 4H
        k := 5
    else if tf <= 1800    // 30m and below → 1D
        k := 6
    else if tf <= 2700    // 45m and below → 12H (720m)
        k := 7
    else if tf <= 3600    // 1H and below → 1D
        k := 8
    else if tf <= 7200    // 2H and below → 2D
        k := 9
    else if tf <= 14400   // 4H and below → 1W
        k := 10
    else if tf <= 21600   // 6H and below → 4D
        k := 11
    else if tf <= 43200   // 12H and below → 1W
        k := 12
    else if tf <= 86400   // 1D and below → 15D
        k := 13
    else if tf <= 259200  // 3D and below → 45D
        k := 14
    else if tf <= 604800  // 1W and below → 15W
        k := 15
    else if tf <= 2592000 // 1M and below → 15M
        k := 16
    else                  // 3M+ → 45M
        k := 17

    string resolvedA = k - 1 >= 0 ? f_getHTFByVal(k - 1) : ""
    string resolvedB = f_getHTFByVal(k)
    string resolvedC = f_getHTFByVal(k + 1)
    string resolvedD = f_getHTFByVal(k + 2)
    [resolvedA, resolvedB, resolvedC, resolvedD]

// Parse comma separated values to array of floats
f_parseTargets(string s) =>
    float[] tgts = array.new_float()
    string cur = ""
    for i = 0 to str.length(s) - 1
        char = str.substring(s, i, i + 1)
        if char == ","
            val = str.tonumber(cur)
            if not na(val)
                array.push(tgts, val)
            cur := ""
        else
            if char != " "
                cur := cur + char
    if str.length(cur) > 0
        val = str.tonumber(cur)
        if not na(val)
            array.push(tgts, val)
    tgts

// Convert text size parameter to Pine size constant
f_getLabelSize(string sz) =>
    switch sz
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.small

// Convert text style parameter to Pine style constant
f_getLineStyle(string st) =>
    switch st
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_dotted

// Convert table text size parameter to Pine size constant
f_getTableTextSize(string sz) =>
    switch sz
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        "large"  => size.large
        "huge"   => size.huge
        => size.tiny

// Convert table position string to position constant
f_getTablePosition(string pos) =>
    switch pos
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right"  => position.bottom_right
        => position.top_right

// Swing points definition helper
f_getHTFData() =>
    hPrev = high[1]
    lPrev = low[1]
    isSwingHigh = high > high[1] and close < close[1]
    isSwingLow = low < low[1] and close > close[1]
    latestSH = ta.valuewhen(isSwingHigh, high, 0)
    latestSL = ta.valuewhen(isSwingLow, low, 0)
    [hPrev, lPrev, latestSH, latestSL]

// HTF FVG Context: fetch just the single most recently CLOSED HTF bar (never the forming bar,
// same repaint discipline as f_getHTFData()). Deliberately trivial — this is the only thing
// evaluated inside request.security() for HTF FVGs. The actual gap-scanning loop runs in the
// main chart context (see f_scanHtfFvgFromArrays below), not inside the security() expression.
f_getHtf1BarData() =>
    [high[1], low[1], time[1]]

// HTF FVG Context: scan an accumulated array of closed-HTF-bar highs/lows (array index n-1 =
// most recently closed HTF bar, going backward from there) for the nearest still-unmitigated
// 3-candle FVG in each direction. This mirrors f_findBullishFVG/f_findBearishFVG's own detection
// and mitigation rule exactly (unmitigated = no more-recent bar has traded through the far
// boundary) and uses the identical dynamic nested-loop technique those functions already run
// successfully in the main context — just reading from an accumulated array (array.get) instead
// of live historical offsets ([i]), since these values came from a different timeframe.
f_scanHtfFvgFromArrays(float[] highs, float[] lows) =>
    float bullTop = na
    float bullBottom = na
    int bullBarsAgo = na
    float bearTop = na
    float bearBottom = na
    int bearBarsAgo = na
    int n = array.size(highs)
    int maxK = math.min(n - 2, 100)
    if maxK >= 1
        for k = 1 to maxK
            int idxK = n - k
            int idxK2 = idxK - 2
            if na(bullTop) and array.get(lows, idxK) > array.get(highs, idxK2)
                fTop = array.get(lows, idxK)
                fBtm = array.get(highs, idxK2)
                bool unmitigated = true
                if k > 1
                    for m = 1 to k - 1
                        if array.get(lows, n - m) < fBtm
                            unmitigated := false
                            break
                if unmitigated
                    bullTop := fTop
                    bullBottom := fBtm
                    bullBarsAgo := k
            if na(bearTop) and array.get(highs, idxK) < array.get(lows, idxK2)
                fTop2 = array.get(lows, idxK2)
                fBtm2 = array.get(highs, idxK)
                bool unmitigated2 = true
                if k > 1
                    for m = 1 to k - 1
                        if array.get(highs, n - m) > fTop2
                            unmitigated2 := false
                            break
                if unmitigated2
                    bearTop := fTop2
                    bearBottom := fBtm2
                    bearBarsAgo := k
            if not na(bullTop) and not na(bearTop)
                break
    [bullTop, bullBottom, bullBarsAgo, bearTop, bearBottom, bearBarsAgo]

// Find opposing candle runs
f_findDownCandlesSeries(sweepOffset) =>
    int startOffset = na
    int endOffset = na
    for i = sweepOffset to sweepOffset + 40
        if i >= bar_index
            break
        if close[i] < open[i]
            int tempEnd = i
            for j = i + 1 to i + 20
                if j >= bar_index
                    break
                if close[j] < open[j]
                    tempEnd := j
                else
                    break
            runLength = tempEnd - i + 1
            if runLength >= 2
                startOffset := i
                endOffset := tempEnd
                break
    [startOffset, endOffset]

f_findUpCandlesSeries(sweepOffset) =>
    int startOffset = na
    int endOffset = na
    for i = sweepOffset to sweepOffset + 40
        if i >= bar_index
            break
        if close[i] > open[i]
            int tempEnd = i
            for j = i + 1 to i + 20
                if j >= bar_index
                    break
                if close[j] > open[j]
                    tempEnd := j
                else
                    break
            runLength = tempEnd - i + 1
            if runLength >= 2
                startOffset := i
                endOffset := tempEnd
                break
    [startOffset, endOffset]

f_getSeriesRange(startOffset, endOffset) =>
    float maxH = na
    float minL = na
    for i = startOffset to endOffset
        maxH := na(maxH) ? high[i] : math.max(maxH, high[i])
        minL := na(minL) ? low[i] : math.min(minL, low[i])
    [maxH, minL]

// Setup Grade: average per-candle volume across the breaker candle series (Volume criterion)
f_getSeriesAvgVolume(startOffset, endOffset) =>
    float totalVol = 0.0
    int count = 0
    for i = startOffset to endOffset
        totalVol += volume[i]
        count += 1
    count > 0 ? totalVol / count : na

// Setup Grade: percentage-of-criteria-passed to letter grade
f_computeGrade(int passed, int total) =>
    string grade = "F"
    if total > 0
        float pct = passed / total
        if pct >= 1.0
            grade := "A"
        else if pct >= 0.75
            grade := "B"
        else if pct >= 0.5
            grade := "C"
        else if pct >= 0.25
            grade := "D"
        else
            grade := "F"
    grade

// FVG Overlap Finders
f_findBullishFVG(breakerT, breakerB, startIdx, enableFvgAtrFilter, fvgAtrMult) =>
    float fvgT = na
    float fvgB = na
    int fvgIdx = na
    int fvgRightIdx = na
    int limit = math.min(bar_index - startIdx, 100)
    if limit >= 0
        for i = 0 to limit
            if low[i] > high[i+2]
                fTop = low[i]
                fBtm = high[i+2]
                atrVal = ta.atr(14)[i]
                if enableFvgAtrFilter and (fTop - fBtm) < (atrVal * fvgAtrMult)
                    continue
                bool overlaps = math.max(fBtm, breakerB) < math.min(fTop, breakerT)
                if overlaps
                    bool unmitigated = true
                    for j = 0 to i
                        if low[j] < fBtm
                            unmitigated := false
                            break
                    if unmitigated
                        fvgT := fTop
                        fvgB := fBtm
                        fvgIdx := bar_index - i - 1
                        fvgRightIdx := bar_index - i  // right boundary: the newer candle
                        break
    [fvgT, fvgB, fvgIdx, fvgRightIdx]

f_findBearishFVG(breakerT, breakerB, startIdx, enableFvgAtrFilter, fvgAtrMult) =>
    float fvgT = na
    float fvgB = na
    int fvgIdx = na
    int fvgRightIdx = na
    int limit = math.min(bar_index - startIdx, 100)
    if limit >= 0
        for i = 0 to limit
            if high[i] < low[i+2]
                fTop = low[i+2]
                fBtm = high[i]
                atrVal = ta.atr(14)[i]
                if enableFvgAtrFilter and (fTop - fBtm) < (atrVal * fvgAtrMult)
                    continue
                bool overlaps = math.max(fBtm, breakerB) < math.min(fTop, breakerT)
                if overlaps
                    bool unmitigated = true
                    for j = 0 to i
                        if high[j] > fTop
                            unmitigated := false
                            break
                    if unmitigated
                        fvgT := fTop
                        fvgB := fBtm
                        fvgIdx := bar_index - i - 1
                        fvgRightIdx := bar_index - i  // right boundary: the newer candle
                        break
    [fvgT, fvgB, fvgIdx, fvgRightIdx]

// HTF FVG Context: has price ever tapped (wicked into) an unmitigated HTF FVG of the given
// direction? This is the "price is delivering from a higher timeframe FVG" gate — price does
// NOT need to still be inside the gap right now, only to have traded into it at some point
// while it was active.
f_hasTappedHtfFvg(bool isBull) =>
    bool result = false
    if array.size(activeHtfFvgs) > 0
        for i = array.size(activeHtfFvgs) - 1 to 0
            fvg = array.get(activeHtfFvgs, i)
            if fvg.isBull == isBull and fvg.tapped
                result := true
    result

// HTF FVG Context: the nearest TAPPED HTF FVG of the given direction (by distance to price) —
// i.e. the specific gap a setup confirming right now is most likely delivering from. Used only
// at setup-confirmation time to draw the "Show Closest HTF FVG" origin box for that one setup;
// does not gate signals. Deliberately does NOT exclude mitigated gaps (a tapped gap still counts
// as the origin even if price later broke fully through it — same reasoning as f_hasTappedHtfFvg).
f_getTappedHtfFvgOrigin(bool isBull) =>
    float bestTop = na
    float bestBottom = na
    int bestStart = na
    string bestTfLabel = ""
    float bestDist = na
    if array.size(activeHtfFvgs) > 0
        for i = array.size(activeHtfFvgs) - 1 to 0
            fvg = array.get(activeHtfFvgs, i)
            if fvg.isBull == isBull and fvg.tapped
                dist = close > fvg.top ? close - fvg.top : (close < fvg.bottom ? fvg.bottom - close : 0.0)
                if na(bestDist) or dist < bestDist
                    bestDist := dist
                    bestTop := fvg.top
                    bestBottom := fvg.bottom
                    bestStart := fvg.startBar
                    bestTfLabel := fvg.tfLabel
    [not na(bestTop), bestTop, bestBottom, bestStart, bestTfLabel]

// HTF FVG Context: compact ICT-style timeframe label (e.g. "M5", "M15", "H1", "H4", "D1"),
// letter-prefix instead of f_getTFLabel's number-suffix style ("5m", "1H") — used only for HTF
// FVG display so the feature reads clean and minimal, independent of the rest of the indicator.
f_getHtfCompactLabel(string tf) =>
    seconds = timeframe.in_seconds(tf)
    res = ""
    if seconds < 60
        res := "S" + str.tostring(seconds)
    else if (seconds / 60) < 60
        res := "M" + str.tostring(math.round(seconds / 60))
    else if (seconds / 3600) < 24
        res := "H" + str.tostring(math.round(seconds / 3600))
    else if (seconds / 86400) < 7
        res := "D" + str.tostring(math.round(seconds / 86400))
    else if (seconds / 604800) < 5
        res := "W" + str.tostring(math.round(seconds / 604800))
    else
        res := "MN" + str.tostring(math.round(seconds / 2592000))
    res

// Size filter
f_checkSizeFilter(breakerTop, breakerBottom, sizeFilterMode, minBreakerSize, maxBreakerSize, breakerSizeUnit) =>
    bool pass = true
    if sizeFilterMode == "Filtered"
        float bSize = breakerTop - breakerBottom
        float checkSize = bSize
        if breakerSizeUnit == "Ticks"
            checkSize := bSize / syminfo.mintick
        else if breakerSizeUnit == "ATR"
            checkSize := bSize / ta.atr(14)
        if checkSize < minBreakerSize or checkSize > maxBreakerSize
            pass := false
    pass

// Find exact extreme index where price was hit (looks back up to 1000 bars)
f_findExtremeBar(float priceVal, bool isHigh) =>
    int extBar = na
    if not na(priceVal)
        for i = 0 to 1000
            if i >= bar_index
                break
            float checkVal = isHigh ? high[i] : low[i]
            if math.abs(checkVal - priceVal) < (syminfo.mintick * 0.1)
                extBar := bar_index - i
                break
    extBar

// Register active levels in memory (no visual rendering here)
f_registerLevel(string tfLabel, string lvlType, bool isHigh, float priceVal) =>
    if not na(priceVal)
        int extBar = f_findExtremeBar(priceVal, isHigh)
        int startB = na(extBar) ? bar_index : extBar

        // Check if the level has already been breached in the past (between startB + 1 and bar_index - 1, capped at 999 bars max)
        int startSearch = math.max(startB + 1, bar_index - 999)
        bool alreadyBreached = false
        if not na(extBar) and startSearch <= bar_index - 1
            for i = startSearch to bar_index - 1
                float checkHigh = high[bar_index - i]
                float checkLow = low[bar_index - i]
                if isHigh and checkHigh >= priceVal
                    alreadyBreached := true
                    break
                else if not isHigh and checkLow <= priceVal
                    alreadyBreached := true
                    break

        if not alreadyBreached
            bool exists = false
            if array.size(activeHTFLevels) > 0
                for i = 0 to array.size(activeHTFLevels) - 1
                    lvl = array.get(activeHTFLevels, i)
                    if not lvl.isSwept and lvl.isHigh == isHigh and math.abs(lvl.price - priceVal) < (syminfo.mintick * 0.1)
                        string searchStr = tfLabel + " " + lvlType
                        if not str.contains(lvl.labelText, searchStr)
                            lvl.labelText := lvl.labelText + ", " + searchStr
                        exists := true
                        break

            if not exists
                string labelTxt = tfLabel + " " + lvlType
                HTFLevel newLvl = HTFLevel.new(
                     tfLabel = tfLabel,
                     levelType = lvlType,
                     isHigh = isHigh,
                     price = priceVal,
                     startBar = startB,
                     isSwept = false,
                     sweepBar = na,
                     labelText = labelTxt
                     )
                array.push(activeHTFLevels, newLvl)

// HTF FVG Context: register a newly detected HTF FVG (called at most once per closed HTF bar per slot)
f_registerHtfFvg(string tfLabel, bool isBull, float topVal, float bottomVal, int startBarIdx) =>
    array.push(activeHtfFvgs, HTFFvg.new(tfLabel, isBull, topVal, bottomVal, startBarIdx, false, false))
    while array.size(activeHtfFvgs) > 50
        array.shift(activeHtfFvgs)

// Position Sizing Calculations (From MTF MA Model)
getContractSize() =>
    ticker = syminfo.ticker
    if str.contains(ticker, "ES") or str.contains(ticker, "MES")
        50.0
    else if str.contains(ticker, "NQ") or str.contains(ticker, "MNQ")
        20.0
    else if str.contains(ticker, "YM") or str.contains(ticker, "MYM")
        5.0
    else if str.contains(ticker, "RTY") or str.contains(ticker, "M2K")
        50.0
    else if str.contains(ticker, "CL") or str.contains(ticker, "MCL")
        1000.0
    else if str.contains(ticker, "GC") or str.contains(ticker, "MGC")
        100.0
    else if str.contains(ticker, "SI") or str.contains(ticker, "SIL")
        5000.0
    else if str.contains(ticker, "BTC")
        1.0
    else if str.contains(ticker, "ETH")
        1.0
    else
        1.0

calculatePositionSize(float entry, float stop, float riskUsd) =>
    riskPerUnit = math.abs(entry - stop)
    positionSize = riskPerUnit != 0 ? riskUsd / riskPerUnit : 0

    detectedMarket = syminfo.type
    if detectedMarket == "forex"
        ticker = syminfo.ticker
        needsConversion = not (str.contains(ticker, "USD") and str.endswith(ticker, "USD")) or str.contains(ticker, "6")
        if needsConversion
            positionSize := (positionSize * entry) / 100000.0
        else
            positionSize := positionSize / 100000.0
    else if detectedMarket == "futures" or detectedMarket == "future" or detectedMarket == "cfd" or detectedMarket == "index"
        contractSize = getContractSize()
        positionSize := positionSize / contractSize

    positionSize

formatPositionSize(float size) =>
    detectedMarket = syminfo.type
    sizeText = ""
    if detectedMarket == "forex"
        sizeText := str.tostring(size, '#.##') + ' lots'
    else if detectedMarket == "futures" or detectedMarket == "future" or detectedMarket == "cfd" or detectedMarket == "index"
        sizeText := str.tostring(size, '#.##') + ' ct'
    else if detectedMarket == "crypto" or detectedMarket == "stock"
        sizeText := str.tostring(size, '#.####') + ' units'
    else
        sizeText := str.tostring(size, '#.####')
    sizeText

