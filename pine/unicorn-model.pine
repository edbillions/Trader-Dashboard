sess2Name = input.string("London", "", inline="cs2", tooltip="Name for session 2.", group=GRP_CONF, active=requireSessionLiq and sess2Enable)
sess3Enable = input.bool(true, "Session 3", inline="cs3", tooltip="Track this session's high and low as liquidity.", group=GRP_CONF, active=requireSessionLiq)
sess3Time = input.session("0930-1200", "", inline="cs3", tooltip="Session 3 range.", group=GRP_CONF, active=requireSessionLiq and sess3Enable)
sess3Name = input.string("NY AM", "", inline="cs3", tooltip="Name for session 3.", group=GRP_CONF, active=requireSessionLiq and sess3Enable)
sess4Enable = input.bool(true, "Session 4", inline="cs4", tooltip="Track this session's high and low as liquidity.", group=GRP_CONF, active=requireSessionLiq)
sess4Time = input.session("1330-1600", "", inline="cs4", tooltip="Session 4 range.", group=GRP_CONF, active=requireSessionLiq and sess4Enable)
sess4Name = input.string("NY PM", "", inline="cs4", tooltip="Name for session 4.", group=GRP_CONF, active=requireSessionLiq and sess4Enable)
sessionSweepWindow = input.int(100, "Session Sweep Validity (Chart Bars)", minval=1, maxval=1000, tooltip="How many CHART BARS a session sweep stays valid for a later Unicorn confirmation.", group=GRP_CONF, active=requireSessionLiq)
showSessionLiq = input.bool(false, "Show Session Liquidity", tooltip="Draw lines for published session highs/lows. Off by default.", group=GRP_CONF)

// --- Filter 3: Influx of volume ---
requireVolume = input.bool(false, "Require Influx of Volume", tooltip="Optional quality filter requiring a measurable volume spike inside the confirmation window. Fails closed (no signal) on symbols without volume data.", group=GRP_CONF)
volumeLookback = input.int(20, "Volume Lookback", minval=1, maxval=500, tooltip="SMA length used as the baseline volume.", group=GRP_CONF, active=requireVolume)
volumeMultiplier = input.float(1.5, "Volume Multiplier", minval=0.1, step=0.1, tooltip="A bar is a volume spike when volume > SMA(volume, lookback) * multiplier.", group=GRP_CONF, active=requireVolume)
volumeConfWindow = input.int(10, "Volume Confirmation Window (Chart Bars)", minval=0, maxval=500, tooltip="Widens the accepted spike period backward from the breaker series start: a spike qualifies when its bar >= breakerSeriesStart - window AND <= the confirmation bar. CHART BARS.", group=GRP_CONF, active=requireVolume)
showVolumeConf = input.bool(false, "Show Volume Confirmation", tooltip="Mark volume-spike bars below the candles. Off by default.", group=GRP_CONF)

// Master switch. While false the entire confluence layer is inert and the indicator
// behaves exactly like the original Unicorn Model.
bool anyConfluenceOn = requireHtfFvg or requireSessionLiq or requireVolume

// ========================================
// MAX BARS BACK ALLOCATION
// ========================================
max_bars_back(high, 1000)
max_bars_back(low, 1000)
max_bars_back(close, 1000)
max_bars_back(open, 1000)

// ========================================
// SYSTEM VARIABLES & TIME RESOLUTION
// ========================================

// Pending Setup State Variables
var int pendingBullSweepIdx = na
var int pendingBullFirstSweepBar = na
var float pendingBullSweepExtreme = na
var float pendingBullSweptLevel = na
var int pendingBullSweptStartBar = na
var string pendingBullSweptLabelText = ""

var int pendingBearSweepIdx = na
var int pendingBearFirstSweepBar = na
var float pendingBearSweepExtreme = na
var float pendingBearSweptLevel = na
var int pendingBearSweptStartBar = na
var string pendingBearSweptLabelText = ""

// Confluence Layer State (additive - never read or written while the filters are off)
var int[] htfTfBarCount = array.new_int(3, 0)   // per-slot confirmed-HTF-bar clock (FVG age, in HTF bars)
var int[] htfTfLastTime = array.new_int(3, 0)   // per-slot time of the last confirmed HTF bar processed
var int lastVolSpikeBar = na        // chart bar_index of the most recent volume spike
var int bullRejBreakerStart = na    // breaker identity of the last confluence-REJECTED bull confirmation
var int bullRejBreakerEnd = na
var int bearRejBreakerStart = na
var int bearRejBreakerEnd = na
var int lastBullSweepCtx = -2       // detects when the existing engine opens a new bull sweep context
var int lastBearSweepCtx = -2

// Time Filter Logic (Uses inputs, must be declared after them)
f_isInSession() =>
    bool inSess = false
    if not enableTimeFilter
        inSess := true
    else
        tz = customTimezone ? "GMT" + (tzHourOffset >= 0 ? "+" : "-") + str.tostring(math.abs(tzHourOffset), "00") + str.tostring(math.abs(tzMinOffset), "00") : syminfo.timezone
        s1 = session1Enable and not na(time(timeframe.period, session1Time, tz))
        s2 = session2Enable and not na(time(timeframe.period, session2Time, tz))
        s3 = session3Enable and not na(time(timeframe.period, session3Time, tz))
        inSess := s1 or s2 or s3
    inSess

// ========================================
// FETCHING DATA RESOLUTION
// ========================================
[autoTA, autoTB, autoTC, autoTD] = getAutoHTFs()

// Check if A is empty (e.g. on 15s chart resolution where k-1 < 0)
bool autoA_valid = autoTA != ""
string finalAutoTA = autoA_valid ? autoTA : timeframe.period

// Resolve final timeframes
htfA_resolved = htfMode == "Automatic" ? finalAutoTA : tfA
htfB_resolved = htfMode == "Automatic" ? autoTB : tfB
htfC_resolved = htfMode == "Automatic" ? autoTC : tfC
htfD_resolved = htfMode == "Automatic" ? autoTD : tfD

// Override the 'use' toggles in Automatic Mode if Source A is invalid
useA_resolved = useA and (htfMode == "Manual" or (htfMode == "Automatic" and autoA_valid))
useB_resolved = useB
useC_resolved = useC
useD_resolved = useD

// Request security for all sources
[prevH_A, prevL_A, sh_A, sl_A] = request.security(syminfo.tickerid, htfA_resolved, f_getHTFData(), barmerge.gaps_off, barmerge.lookahead_off)
[prevH_B, prevL_B, sh_B, sl_B] = request.security(syminfo.tickerid, htfB_resolved, f_getHTFData(), barmerge.gaps_off, barmerge.lookahead_off)
[prevH_C, prevL_C, sh_C, sl_C] = request.security(syminfo.tickerid, htfC_resolved, f_getHTFData(), barmerge.gaps_off, barmerge.lookahead_off)
[prevH_D, prevL_D, sh_D, sl_D] = request.security(syminfo.tickerid, htfD_resolved, f_getHTFData(), barmerge.gaps_off, barmerge.lookahead_off)

// HTF FVG source timeframes for the confluence layer - three independent slots.
// Manual  = the three timeframes set in the inputs (15m / 1H / 4H by default).
// Automatic = Liquidity Sources B, C and D's resolved timeframes.
string htfFvgTF1 = htfFvgTfMode == "Manual" ? htfFvgTf1 : htfB_resolved
string htfFvgTF2 = htfFvgTfMode == "Manual" ? htfFvgTf2 : htfC_resolved
string htfFvgTF3 = htfFvgTfMode == "Manual" ? htfFvgTf3 : htfD_resolved

[fvg1L1, fvg1H1, fvg1L3, fvg1H3, fvg1Atr, fvg1T] = request.security(syminfo.tickerid, htfFvgTF1, f_htfFvgData(), barmerge.gaps_off, barmerge.lookahead_off)
[fvg2L1, fvg2H1, fvg2L3, fvg2H3, fvg2Atr, fvg2T] = request.security(syminfo.tickerid, htfFvgTF2, f_htfFvgData(), barmerge.gaps_off, barmerge.lookahead_off)
[fvg3L1, fvg3H1, fvg3L3, fvg3H3, fvg3Atr, fvg3T] = request.security(syminfo.tickerid, htfFvgTF3, f_htfFvgData(), barmerge.gaps_off, barmerge.lookahead_off)

// ----------------------------------------
// CONFLUENCE LAYER HELPERS
// (declared after the HTF FVG requests so they can read the resolved timeframes)
// ----------------------------------------

// Timezone for the session liquidity engine (mirrors the existing Time Filter architecture)
f_confTz() =>
    customTimezone ? "GMT" + (tzHourOffset >= 0 ? "+" : "-") + str.tostring(math.abs(tzHourOffset), "00") + str.tostring(math.abs(tzMinOffset), "00") : syminfo.timezone

// Per-session running high/low. Pine gives every call site its own copy of the `var` state.
// The level is only PUBLISHED when the session ends, so an in-progress session extreme is
// never sweepable and no future session data can be used.
f_trackSession(bool enabled, bool inSess, bool isStart, bool isEnd) =>
    var float hi = na
    var float lo = na
    float pubHi = na
    float pubLo = na
    if enabled
        if isStart
            hi := high
            lo := low
        else if inSess
            hi := na(hi) ? high : math.max(hi, high)
            lo := na(lo) ? low : math.min(lo, low)
        if isEnd and not na(hi) and not na(lo)
            pubHi := hi
            pubLo := lo
    [pubHi, pubLo]

// Publish a completed session level into the sweepable set
f_pushSessLevel(string nm, bool isHigh, float px) =>
    bool pushed = false
    if not na(px)
        line vz = na
        if showSessionLiq
            vz := line.new(
                 x1 = bar_index,
                 y1 = px,
                 x2 = bar_index,
                 y2 = px,
                 color = isHigh ? color.new(color.red, 40) : color.new(color.green, 40),
                 style = line.style_dotted,
                 width = 1
                 )
        array.push(sessLevels, SessLevel.new(
             sessName = nm,
             isHigh = isHigh,
             price = px,
             formBar = bar_index,
             swept = false,
             sweepBar = na,
             vizLine = vz
             ))
        pushed := true
    pushed

// Bound each HTF FVG timeframe's memory INDEPENDENTLY, so a fast timeframe can never crowd
// the slower timeframes' gaps out of the shared array.
f_pruneHtfFvgSlot(int slot, int maxPerSlot) =>
    int cnt = 0
    if array.size(htfFvgs) > 0
        for i = 0 to array.size(htfFvgs) - 1
            if array.get(htfFvgs, i).tfSlot == slot
                cnt += 1
    int toDrop = cnt - maxPerSlot
    if toDrop > 0
        for d = 1 to toDrop
            int oldest = -1
            if array.size(htfFvgs) > 0
                for i = 0 to array.size(htfFvgs) - 1
                    if array.get(htfFvgs, i).tfSlot == slot
                        oldest := i
                        break
            if oldest >= 0
                dropped = array.remove(htfFvgs, oldest)
                if not na(dropped.vizBox)
                    box.delete(dropped.vizBox)
    cnt

// Register the HTF FVGs of ONE timeframe slot. The body only runs when that slot reports a NEW
// confirmed HTF bar, so a gap can never appear before its third HTF candle has closed.
f_registerHtfFvgSlot(int slot, string tfLabel, bool enabled, float l1, float h1, float l3, float h3, float atrC, int t) =>
    bool added = false
    if enabled and not na(t)
        int lastT = array.get(htfTfLastTime, slot)
        if lastT == 0 or t != lastT
            array.set(htfTfLastTime, slot, t)
            array.set(htfTfBarCount, slot, array.get(htfTfBarCount, slot) + 1)
            int cnt = array.get(htfTfBarCount, slot)

            // Bullish HTF FVG: 3rd candle's low above the 1st candle's high
            if not na(l1) and not na(h3) and l1 > h3
                box vzBull = na
                if showHtfFvgs
                    vzBull := box.new(left = bar_index, top = l1, right = bar_index, bottom = h3, border_color = color.new(na, na), bgcolor = htfFvgBullColor, xloc = xloc.bar_index, text = tfLabel, text_size = size.tiny, text_color = color.new(color.gray, 10), text_halign = text.align_right, text_valign = text.align_center)
                array.push(htfFvgs, HTFFVG.new(
                     top = l1,
                     bottom = h3,
                     isBull = true,
                     tfSlot = slot,
                     tfLabel = tfLabel,
                     formHtfIdx = cnt,
                     formBar = bar_index,
                     atrAtForm = atrC,
                     mitigated = false,
                     touched = false,
                     entered = false,
                     reached50 = false,
                     vizBox = vzBull
                     ))
                added := true

            // Bearish HTF FVG: 3rd candle's high below the 1st candle's low
            if not na(h1) and not na(l3) and h1 < l3
                box vzBear = na
                if showHtfFvgs
                    vzBear := box.new(left = bar_index, top = l3, right = bar_index, bottom = h1, border_color = color.new(na, na), bgcolor = htfFvgBearColor, xloc = xloc.bar_index, text = tfLabel, text_size = size.tiny, text_color = color.new(color.gray, 10), text_halign = text.align_right, text_valign = text.align_center)
                array.push(htfFvgs, HTFFVG.new(
                     top = l3,
                     bottom = h1,
                     isBull = false,
                     tfSlot = slot,
                     tfLabel = tfLabel,
                     formHtfIdx = cnt,
                     formBar = bar_index,
                     atrAtForm = atrC,
                     mitigated = false,
                     touched = false,
                     entered = false,
                     reached50 = false,
                     vizBox = vzBear
                     ))
                added := true

            f_pruneHtfFvgSlot(slot, 20)
    added

// Per-slot delivery verdict. Age is measured against THAT slot's own confirmed-HTF-bar clock,
// so a 15m gap and a 4H gap are never aged with the same ruler. Only the SELECTED delivery
// mode's flag is read.
f_htfFvgSlotOK(bool isBull) =>
    bool ok0 = false
    bool ok1 = false
    bool ok2 = false
    if array.size(htfFvgs) > 0
        for i = array.size(htfFvgs) - 1 to 0
            g = array.get(htfFvgs, i)
            if g.isBull == isBull and not g.mitigated and (array.get(htfTfBarCount, g.tfSlot) - g.formHtfIdx) <= htfFvgMaxAge
                bool sizeOK = htfFvgMinAtr <= 0.0 or (not na(g.atrAtForm) and (g.top - g.bottom) >= (g.atrAtForm * htfFvgMinAtr))
                bool delivered = htfFvgDelivery == "Touch" ? g.touched : htfFvgDelivery == "Enter" ? g.entered : g.reached50
                if sizeOK and delivered
                    if g.tfSlot == 0
                        ok0 := true
                    else if g.tfSlot == 1
                        ok1 := true
                    else
                        ok2 := true
    [ok0, ok1, ok2]

// GATE 1 - combine the per-slot verdicts across the ENABLED HTF FVG timeframes.
// Any Timeframe: one enabled timeframe delivering is enough.
// All Enabled Timeframes: every enabled timeframe must deliver.
// No timeframe enabled at all: fails closed.
f_htfFvgGateOK(bool isBull) =>
    [ok0, ok1, ok2] = f_htfFvgSlotOK(isBull)
    int enabledN = (htfFvgTf1Enable ? 1 : 0) + (htfFvgTf2Enable ? 1 : 0) + (htfFvgTf3Enable ? 1 : 0)
    bool anyOK = (htfFvgTf1Enable and ok0) or (htfFvgTf2Enable and ok1) or (htfFvgTf3Enable and ok2)
    bool allOK = (not htfFvgTf1Enable or ok0) and (not htfFvgTf2Enable or ok1) and (not htfFvgTf3Enable or ok2)
    enabledN == 0 ? false : (htfFvgConfluenceMode == "All Enabled Timeframes" ? allOK : anyOK)

// Compact per-timeframe status, e.g. "15m✓ 1H✕ 4H✓"
f_htfTfStatusText(bool isBull) =>
    [ok0, ok1, ok2] = f_htfFvgSlotOK(isBull)
    string txt = ""
    if htfFvgTf1Enable
        txt := f_getTFLabel(htfFvgTF1) + (ok0 ? "✓" : "✕")
    if htfFvgTf2Enable
        txt := txt + (str.length(txt) > 0 ? " " : "") + f_getTFLabel(htfFvgTF2) + (ok1 ? "✓" : "✕")
    if htfFvgTf3Enable
        txt := txt + (str.length(txt) > 0 ? " " : "") + f_getTFLabel(htfFvgTF3) + (ok2 ? "✓" : "✕")
    str.length(txt) > 0 ? txt : "none enabled"

// GATE 2 - a session sweep in the correct direction inside the chart-bar validity window.
// Bullish delivery needs a swept session LOW, bearish a swept session HIGH.
f_sessionGateOK(bool isBull) =>
    bool ok = false
    if array.size(sessLevels) > 0
        for i = array.size(sessLevels) - 1 to 0
            s = array.get(sessLevels, i)
            if s.swept and not na(s.sweepBar) and s.isHigh == (not isBull)
                if s.sweepBar <= bar_index and s.sweepBar >= (bar_index - sessionSweepWindow)
                    ok := true
                    break
    ok

// Name of the most recent qualifying swept session level, for the setup tooltip
f_sessionSweptName(bool isBull) =>
    string nm = ""
    if array.size(sessLevels) > 0
        for i = array.size(sessLevels) - 1 to 0
            s = array.get(sessLevels, i)
            if s.swept and not na(s.sweepBar) and s.isHigh == (not isBull)
                if s.sweepBar <= bar_index and s.sweepBar >= (bar_index - sessionSweepWindow)
                    nm := s.sessName
                    break
    nm

// GATE 3 - volume spike inside [breaker series start - window, confirmation bar].
// A spike from before that window can never qualify the setup.
f_volumeGateOK(int breakerSeriesStartBar) =>
    bool ok = false
    if not na(lastVolSpikeBar) and not na(breakerSeriesStartBar)
        ok := lastVolSpikeBar >= (breakerSeriesStartBar - volumeConfWindow) and lastVolSpikeBar <= bar_index
    ok

// Combined gate. Each disabled filter contributes nothing, so with all three filters off this
// is a constant true and the existing confirmation path is unchanged.
f_confluenceGate(bool isBull, int breakerSeriesStartBar) =>
    bool ok = true
    if requireHtfFvg
        ok := ok and f_htfFvgGateOK(isBull)
    if requireSessionLiq
        ok := ok and f_sessionGateOK(isBull)
    if requireVolume
        ok := ok and f_volumeGateOK(breakerSeriesStartBar)
    ok

// Compact confluence description appended to the setup tooltip (only when a filter is enabled)
f_confluenceTagText(bool isBull) =>
    string t = ""
    if requireHtfFvg
        t := "HTF FVG " + htfFvgDelivery + " [" + f_htfTfStatusText(isBull) + "]"
    if requireSessionLiq
        string sName = f_sessionSweptName(isBull)
        t := t + (str.length(t) > 0 ? " | " : "") + "Session Liq" + (str.length(sName) > 0 ? " [" + sName + "]" : "")
    if requireVolume
        t := t + (str.length(t) > 0 ? " | " : "") + "Volume"
    t


// Track formation bar index for each liquidity level
var float lastPrevH_A = na
var float lastSh_A = na
var float lastPrevL_A = na
var float lastSl_A = na

var float lastPrevH_B = na
var float lastSh_B = na
var float lastPrevL_B = na
var float lastSl_B = na

var float lastPrevH_C = na
var float lastSh_C = na
var float lastPrevL_C = na
var float lastSl_C = na

var float lastPrevH_D = na
var float lastSh_D = na
var float lastPrevL_D = na
var float lastSl_D = na

// Register newly formed levels on change
// Source A
if useA_resolved
    if (typeA == "OHLC" or typeA == "OHLC + Swing")
        if prevH_A != lastPrevH_A or (na(lastPrevH_A) and not na(prevH_A))
            lastPrevH_A := prevH_A
            f_registerLevel(f_getTFLabel(htfA_resolved), "OHLC", true, prevH_A)
        if prevL_A != lastPrevL_A or (na(lastPrevL_A) and not na(prevL_A))
            lastPrevL_A := prevL_A
            f_registerLevel(f_getTFLabel(htfA_resolved), "OHLC", false, prevL_A)
    if (typeA == "Swing" or typeA == "OHLC + Swing")
        if sh_A != lastSh_A or (na(lastSh_A) and not na(sh_A))
            lastSh_A := sh_A
            f_registerLevel(f_getTFLabel(htfA_resolved), "Swing", true, sh_A)
        if sl_A != lastSl_A or (na(lastSl_A) and not na(sl_A))
            lastSl_A := sl_A
            f_registerLevel(f_getTFLabel(htfA_resolved), "Swing", false, sl_A)

// Source B
if useB_resolved
    if (typeB == "OHLC" or typeB == "OHLC + Swing")
        if prevH_B != lastPrevH_B or (na(lastPrevH_B) and not na(prevH_B))
            lastPrevH_B := prevH_B
            f_registerLevel(f_getTFLabel(htfB_resolved), "OHLC", true, prevH_B)
        if prevL_B != lastPrevL_B or (na(lastPrevL_B) and not na(prevL_B))
            lastPrevL_B := prevL_B
            f_registerLevel(f_getTFLabel(htfB_resolved), "OHLC", false, prevL_B)
    if (typeB == "Swing" or typeB == "OHLC + Swing")
        if sh_B != lastSh_B or (na(lastSh_B) and not na(sh_B))
            lastSh_B := sh_B
            f_registerLevel(f_getTFLabel(htfB_resolved), "Swing", true, sh_B)
        if sl_B != lastSl_B or (na(lastSl_B) and not na(sl_B))
            lastSl_B := sl_B
            f_registerLevel(f_getTFLabel(htfB_resolved), "Swing", false, sl_B)

// Source C
if useC_resolved
    if (typeC == "OHLC" or typeC == "OHLC + Swing")
        if prevH_C != lastPrevH_C or (na(lastPrevH_C) and not na(prevH_C))
            lastPrevH_C := prevH_C
            f_registerLevel(f_getTFLabel(htfC_resolved), "OHLC", true, prevH_C)
        if prevL_C != lastPrevL_C or (na(lastPrevL_C) and not na(prevL_C))
            lastPrevL_C := prevL_C
            f_registerLevel(f_getTFLabel(htfC_resolved), "OHLC", false, prevL_C)
    if (typeC == "Swing" or typeC == "OHLC + Swing")
        if sh_C != lastSh_C or (na(lastSh_C) and not na(sh_C))
            lastSh_C := sh_C
            f_registerLevel(f_getTFLabel(htfC_resolved), "Swing", true, sh_C)
        if sl_C != lastSl_C or (na(lastSl_C) and not na(sl_C))
            lastSl_C := sl_C
            f_registerLevel(f_getTFLabel(htfC_resolved), "Swing", false, sl_C)

// Source D
if useD_resolved
    if (typeD == "OHLC" or typeD == "OHLC + Swing")
        if prevH_D != lastPrevH_D or (na(lastPrevH_D) and not na(prevH_D))
            lastPrevH_D := prevH_D
            f_registerLevel(f_getTFLabel(htfD_resolved), "OHLC", true, prevH_D)
        if prevL_D != lastPrevL_D or (na(lastPrevL_D) and not na(prevL_D))
            lastPrevL_D := prevL_D
            f_registerLevel(f_getTFLabel(htfD_resolved), "OHLC", false, prevL_D)
    if (typeD == "Swing" or typeD == "OHLC + Swing")
        if sh_D != lastSh_D or (na(lastSh_D) and not na(sh_D))
            lastSh_D := sh_D
            f_registerLevel(f_getTFLabel(htfD_resolved), "Swing", true, sh_D)
        if sl_D != lastSl_D or (na(lastSl_D) and not na(sl_D))
            lastSl_D := sl_D
            f_registerLevel(f_getTFLabel(htfD_resolved), "Swing", false, sl_D)

// ========================================
// MAIN EXECUTION STATE MACHINE (Level update & sweep check)
// ========================================
bool sweptBull = false
float sweptBullPrice = na
int sweptBullStartBar = na
string sweptBulllabelText = ""

bool sweptBear = false
float sweptBearPrice = na
int sweptBearStartBar = na
string sweptBearlabelText = ""

if array.size(activeHTFLevels) > 0
    for idx = array.size(activeHTFLevels) - 1 to 0
        lvl = array.get(activeHTFLevels, idx)

        bool swept = false
        if lvl.isHigh
            if high >= lvl.price
                swept := true
                sweptBull := true
                if na(sweptBullPrice) or lvl.price > sweptBullPrice
                    sweptBullPrice := lvl.price
                    sweptBullStartBar := lvl.startBar
                    sweptBulllabelText := lvl.labelText
                else if lvl.price == sweptBullPrice
                    if not str.contains(sweptBulllabelText, lvl.labelText)
                        sweptBulllabelText := sweptBulllabelText + ", " + lvl.labelText
        else
            if low <= lvl.price
                swept := true
                sweptBear := true
                if na(sweptBearPrice) or lvl.price < sweptBearPrice
                    sweptBearPrice := lvl.price
                    sweptBearStartBar := lvl.startBar
                    sweptBearlabelText := lvl.labelText
                else if lvl.price == sweptBearPrice
                    if not str.contains(sweptBearlabelText, lvl.labelText)
                        sweptBearlabelText := sweptBearlabelText + ", " + lvl.labelText

        if swept
            lvl.isSwept := true
            lvl.sweepBar := bar_index
            // Performance Optimization: Immediately remove swept level from execution array
            array.remove(activeHTFLevels, idx)

// Limit level memory history to prevent array overflow
while array.size(activeHTFLevels) > 100
    array.shift(activeHTFLevels)

// 2. Process & Track Sweeps
if sweptBear and (biasSelect == "Neutral" or biasSelect == "Bullish")
    pendingBullSweepIdx := bar_index
    pendingBullFirstSweepBar := bar_index
    pendingBullSweepExtreme := low
    pendingBullSweptLevel := sweptBearPrice
    pendingBullSweptStartBar := sweptBearStartBar
    pendingBullSweptLabelText := sweptBearlabelText
else if not na(pendingBullSweepIdx) and low < pendingBullSweepExtreme
    pendingBullSweepExtreme := low
    pendingBullSweepIdx := bar_index

if sweptBull and (biasSelect == "Neutral" or biasSelect == "Bearish")
    pendingBearSweepIdx := bar_index
    pendingBearFirstSweepBar := bar_index
    pendingBearSweepExtreme := high
    pendingBearSweptLevel := sweptBullPrice
    pendingBearSweptStartBar := sweptBullStartBar
    pendingBearSweptLabelText := sweptBulllabelText
else if not na(pendingBearSweepIdx) and high > pendingBearSweepExtreme
    pendingBearSweepExtreme := high
    pendingBearSweepIdx := bar_index

// ========================================
// CONFLUENCE LAYER STATE UPDATE
// Latches everything the gates read, BEFORE setup confirmation runs below.
// Uses only current/past bars - never future information.
// ========================================

// --- Clear the confluence rejection memory whenever the existing engine opens a new sweep context ---
int curBullCtx = nz(pendingBullFirstSweepBar, -1)
if curBullCtx != lastBullSweepCtx
    lastBullSweepCtx := curBullCtx
    bullRejBreakerStart := na
    bullRejBreakerEnd := na

int curBearCtx = nz(pendingBearFirstSweepBar, -1)
if curBearCtx != lastBearSweepCtx
    lastBearSweepCtx := curBearCtx
    bearRejBreakerStart := na
    bearRejBreakerEnd := na

// --- HTF FVG registration across all enabled timeframes (only on NEW CONFIRMED HTF bars) ---
f_registerHtfFvgSlot(0, f_getTFLabel(htfFvgTF1), htfFvgTf1Enable, fvg1L1, fvg1H1, fvg1L3, fvg1H3, fvg1Atr, fvg1T)
f_registerHtfFvgSlot(1, f_getTFLabel(htfFvgTF2), htfFvgTf2Enable, fvg2L1, fvg2H1, fvg2L3, fvg2H3, fvg2Atr, fvg2T)
f_registerHtfFvgSlot(2, f_getTFLabel(htfFvgTF3), htfFvgTf3Enable, fvg3L1, fvg3H1, fvg3L3, fvg3H3, fvg3Atr, fvg3T)

// --- HTF FVG delivery flags + mitigation, evaluated on the current bar only ---
if array.size(htfFvgs) > 0
    for i = 0 to array.size(htfFvgs) - 1
        g = array.get(htfFvgs, i)
        if not g.mitigated
            float eq = (g.top + g.bottom) / 2.0

            // Touch: the bar range overlaps any part of the gap (boundary counts)
            if high >= g.bottom and low <= g.top
                g.touched := true

            // Enter: strictly positive overlap with the gap interior
            if math.min(high, g.top) > math.max(low, g.bottom)
                g.entered := true

            // 50%: the bar's own range must straddle the equilibrium level
            if low <= eq and high >= eq
                g.reached50 := true

            bool mit = htfFvgMitigation == "Close Through" ? (g.isBull ? close < g.bottom : close > g.top) : (g.isBull ? low < g.bottom : high > g.top)
            if mit
                g.mitigated := true

            if showHtfFvgs and not na(g.vizBox) and not g.mitigated
                box.set_right(g.vizBox, bar_index)

// Bounded memory backstop (each timeframe slot is already capped at 20 by f_pruneHtfFvgSlot)
while array.size(htfFvgs) > 80
    oldFvg = array.shift(htfFvgs)
    if not na(oldFvg.vizBox)
        box.delete(oldFvg.vizBox)

// --- Session liquidity: levels are published only after a session CLOSES ---
string confTz = f_confTz()
bool inS1Raw = not na(time(timeframe.period, sess1Time, confTz))
bool inS2Raw = not na(time(timeframe.period, sess2Time, confTz))
bool inS3Raw = not na(time(timeframe.period, sess3Time, confTz))
bool inS4Raw = not na(time(timeframe.period, sess4Time, confTz))

[s1Hi, s1Lo] = f_trackSession(sess1Enable, inS1Raw, inS1Raw and not inS1Raw[1], not inS1Raw and inS1Raw[1])
[s2Hi, s2Lo] = f_trackSession(sess2Enable, inS2Raw, inS2Raw and not inS2Raw[1], not inS2Raw and inS2Raw[1])
[s3Hi, s3Lo] = f_trackSession(sess3Enable, inS3Raw, inS3Raw and not inS3Raw[1], not inS3Raw and inS3Raw[1])
[s4Hi, s4Lo] = f_trackSession(sess4Enable, inS4Raw, inS4Raw and not inS4Raw[1], not inS4Raw and inS4Raw[1])

f_pushSessLevel(sess1Name, true, s1Hi)
f_pushSessLevel(sess1Name, false, s1Lo)
f_pushSessLevel(sess2Name, true, s2Hi)
f_pushSessLevel(sess2Name, false, s2Lo)
f_pushSessLevel(sess3Name, true, s3Hi)
f_pushSessLevel(sess3Name, false, s3Lo)
f_pushSessLevel(sess4Name, true, s4Hi)
f_pushSessLevel(sess4Name, false, s4Lo)

// Sweep detection for published session levels (never on the bar the level was published)
if array.size(sessLevels) > 0
    for i = 0 to array.size(sessLevels) - 1
        sl = array.get(sessLevels, i)
        if not sl.swept and sl.formBar < bar_index
            if sl.isHigh and high > sl.price
                sl.swept := true
                sl.sweepBar := bar_index
            else if not sl.isHigh and low < sl.price
                sl.swept := true
                sl.sweepBar := bar_index
        if showSessionLiq and not na(sl.vizLine) and not sl.swept
            line.set_x2(sl.vizLine, bar_index)

// Bounded memory: drop the oldest session levels
while array.size(sessLevels) > 32
    oldSess = array.shift(sessLevels)
    if not na(oldSess.vizLine)
        line.delete(oldSess.vizLine)

// --- Volume influx: objective, measured on the bar itself ---
float volAvg = ta.sma(volume, volumeLookback)
bool volSpike = not na(volume) and volume > 0 and not na(volAvg) and volAvg > 0 and volume > (volAvg * volumeMultiplier)
if volSpike
    lastVolSpikeBar := bar_index

plotchar(showVolumeConf and volSpike, title = "Volume Influx", char = "▲", location = location.belowbar, color = color.new(color.aqua, 0), size = size.tiny)

// 3. Track & Confirm Pending Setups

// Track Bullish setups
if not na(pendingBullSweepIdx)
    sweepOffset = bar_index - pendingBullSweepIdx
    [startOffset, endOffset] = f_findUpCandlesSeries(sweepOffset)

    if not na(startOffset)
        [breakerT, breakerB] = f_getSeriesRange(startOffset, endOffset)

        // Validation: Breaker bottom must not be below (more extreme than) the sweep low extreme
        if close > breakerT and breakerB >= pendingBullSweepExtreme and f_isInSession()
            if f_checkSizeFilter(breakerT, breakerB, sizeFilterMode, minBreakerSize, maxBreakerSize, breakerSizeUnit)
                breakerStartBar = bar_index - endOffset
                [fvgT, fvgB, fvgIdx, fvgRightIdx] = f_findBullishFVG(breakerT, breakerB, breakerStartBar, enableFvgAtrFilter, fvgAtrMult)
                hasFvg = not na(fvgIdx)

                if not unicornMode or (unicornMode and hasFvg)
                    float invPrice = useSwingInvalidation ? pendingBullSweepExtreme : breakerB
                    float riskRange = breakerT - invPrice

                    // Confluence gate - evaluated ONLY at the existing confirmation point, using
                    // information available on this bar. A rejection is remembered against the
                    // breaker identity, so this same setup can never be activated later by a
                    // confluence condition that only becomes true afterwards.
                    bool confluencePass = true
                    if anyConfluenceOn and riskRange > 0
                        int cbStart = bar_index - startOffset
                        int cbEnd = bar_index - endOffset
                        bool alreadyRejected = not na(bullRejBreakerStart) and bullRejBreakerStart == cbStart and bullRejBreakerEnd == cbEnd
                        confluencePass := not alreadyRejected and f_confluenceGate(true, breakerStartBar)
                        if not confluencePass
                            bullRejBreakerStart := cbStart
                            bullRejBreakerEnd := cbEnd

                    if riskRange > 0 and confluencePass
                        Setup newBull = Setup.new(
                             dir = "BULL",
                             sweepIndex = pendingBullFirstSweepBar,
                             sweepExtreme = pendingBullSweepExtreme,
                             sweptLevel = pendingBullSweptLevel,
                             sweptLevelStartBar = pendingBullSweptStartBar,
                             breakerStartIdx = bar_index - startOffset,
                             breakerEndIdx = bar_index - endOffset,
                             breakerTop = breakerT,
                             breakerBottom = breakerB,
                             isConfirmed = true,
                             confIndex = bar_index,
                             entryPrice = breakerT,
                             invalidationPrice = invPrice,
                             isInvalidated = false,
                             isTargetHit = false,
                             levelLine = na,
                             levelLabel = na,
                             breakerBox = na,
                             fvgBox = na,
                             targetLines = array.new_line(),
                             targetLabels = array.new_label(),
                             setupLabel = na
                             )

                        // Setup-linked level line (starts at exact extreme index, ends at sweepIndex)
                        int lineStartB = math.max(newBull.sweptLevelStartBar, bar_index - 4500)
                        newBull.levelLine := line.new(
                             x1 = lineStartB,
                             y1 = newBull.sweptLevel,
                             x2 = newBull.sweepIndex,
                             y2 = newBull.sweptLevel,
                             color = sweepLineColor,
                             style = f_getLineStyle(sweepLineStyle),
                             width = sweepLineWidth
                             )

                        newBull.levelLabel := label.new(
                             x = lineStartB,
                             y = newBull.sweptLevel + (nz(ta.atr(14)) * 0.1),
                             text = pendingBullSweptLabelText,
                             color = color.new(na, na),
                             textcolor = labelTextColor,
                             style = label.style_label_left,
                             size = f_getLabelSize(labelSizeStr),
                             text_font_family = font.family_monospace
                             )

                        newBull.breakerBox := box.new(
                             left = bar_index - endOffset,
                             top = newBull.breakerTop,
                             right = bar_index,
                             bottom = newBull.breakerBottom,
                             border_color = bullColorBorder,
                             bgcolor = bullColorActive,
                             xloc = xloc.bar_index
                             )

                        if hasFvg
                            newBull.fvgBox := box.new(
                                 left = fvgIdx,
                                 top = fvgT,
                                 right = fvgRightIdx,
                                 bottom = fvgB,
                                 border_color = color.new(na, na),
                                 bgcolor = bullFvgColor,
                                 xloc = xloc.bar_index
                                 )

                        labelText = hasFvg ? "+Unicorn" : "+Breaker"
                        tooltipText = "Setup: " + (hasFvg ? "Bullish Unicorn" : "Bullish Breaker") + "\n" +
                                     "Swept Level: " + str.tostring(newBull.sweptLevel, format.mintick) + "\n" +
                                     "Entry: " + str.tostring(newBull.entryPrice, format.mintick) + "\n" +
                                     "Stop Loss: " + str.tostring(newBull.invalidationPrice, format.mintick)

                        newBull.setupLabel := label.new(
                             x = bar_index,
                             y = (newBull.breakerTop + newBull.breakerBottom) / 2.0,
                             text = labelText,
                             color = color.new(na, na),
                             textcolor = labelTextColor,
                             style = label.style_label_right,
                             size = f_getLabelSize(labelSizeStr),
                             tooltip = tooltipText,
                             text_font_family = font.family_monospace
                             )

                        if anyConfluenceOn
                            label.set_tooltip(newBull.setupLabel, tooltipText + "\nConfluence: " + f_confluenceTagText(true))

                        primaryTargetPrice = newBull.entryPrice + rrRatio * riskRange
                        if showRRTarget
                            l = line.new(
                                 x1 = newBull.breakerEndIdx,
                                 y1 = primaryTargetPrice,
                                 x2 = newBull.confIndex,
                                 y2 = primaryTargetPrice,
                                 color = labelTextColor,
                                 style = f_getLineStyle(projLineStyle),
                                 width = projLineWidth
                                 )
                            lbl = label.new(
                                 x = newBull.confIndex,
                                 y = primaryTargetPrice,
                                 text = str.tostring(rrRatio, "#.##") + "R",
                                 color = color.new(na, na),
                                 textcolor = labelTextColor,
                                 style = label.style_label_left,
                                 size = f_getLabelSize(labelSizeStr),
                                 tooltip = "Target level: " + str.tostring(primaryTargetPrice, format.mintick),
                                 text_font_family = font.family_monospace
                                 )
                            array.push(newBull.targetLines, l)
                            array.push(newBull.targetLabels, lbl)

                        if showAddTargets
                            tgts = f_parseTargets(addTargetsStr)
                            if array.size(tgts) > 0
                                for i = 0 to array.size(tgts) - 1
                                    m = array.get(tgts, i)
                                    tgtVal = newBull.entryPrice + m * riskRange
                                    l = line.new(
                                         x1 = newBull.breakerEndIdx,
                                         y1 = tgtVal,
                                         x2 = newBull.confIndex,
                                         y2 = tgtVal,
                                         color = labelTextColor,
                                         style = f_getLineStyle(projLineStyle),
                                         width = projLineWidth
                                         )
                                    lbl = label.new(
                                         x = newBull.confIndex,
                                         y = tgtVal,
                                         text = str.tostring(m, "#.##") + "R",
                                         color = color.new(na, na),
                                         textcolor = labelTextColor,
                                         style = label.style_label_left,
                                         size = f_getLabelSize(labelSizeStr),
                                         tooltip = "Target level: " + str.tostring(tgtVal, format.mintick),
                                         text_font_family = font.family_monospace
                                         )
                                    array.push(newBull.targetLines, l)
                                    array.push(newBull.targetLabels, lbl)

                        array.push(activeSetups, newBull)

                        if enableAlerts and alertActivation
                            alert("Activation: Bullish Breaker activated on " + syminfo.ticker + " at " + str.tostring(newBull.entryPrice), alert.freq_once_per_bar_close)

                        pendingBullSweepIdx := na
                        pendingBullFirstSweepBar := na

// Track Bearish setups
if not na(pendingBearSweepIdx)
    sweepOffset = bar_index - pendingBearSweepIdx
    [startOffset, endOffset] = f_findDownCandlesSeries(sweepOffset)

    if not na(startOffset)
        [breakerT, breakerB] = f_getSeriesRange(startOffset, endOffset)

        // Validation: Breaker top must not be above (more extreme than) the sweep high extreme
        if close < breakerB and breakerT <= pendingBearSweepExtreme and f_isInSession()
            if f_checkSizeFilter(breakerT, breakerB, sizeFilterMode, minBreakerSize, maxBreakerSize, breakerSizeUnit)
                breakerStartBar = bar_index - endOffset
                [fvgT, fvgB, fvgIdx, fvgRightIdx] = f_findBearishFVG(breakerT, breakerB, breakerStartBar, enableFvgAtrFilter, fvgAtrMult)
                hasFvg = not na(fvgIdx)

                if not unicornMode or (unicornMode and hasFvg)
                    float invPrice = useSwingInvalidation ? pendingBearSweepExtreme : breakerT
                    float riskRange = invPrice - breakerB

                    // Confluence gate - see the bullish block for the full rationale.
                    bool confluencePass = true
                    if anyConfluenceOn and riskRange > 0
                        int cbStart = bar_index - startOffset
                        int cbEnd = bar_index - endOffset
                        bool alreadyRejected = not na(bearRejBreakerStart) and bearRejBreakerStart == cbStart and bearRejBreakerEnd == cbEnd
                        confluencePass := not alreadyRejected and f_confluenceGate(false, breakerStartBar)
                        if not confluencePass
                            bearRejBreakerStart := cbStart
                            bearRejBreakerEnd := cbEnd

                    if riskRange > 0 and confluencePass
                        Setup newBear = Setup.new(
                             dir = "BEAR",
                             sweepIndex = pendingBearFirstSweepBar,
                             sweepExtreme = pendingBearSweepExtreme,
                             sweptLevel = pendingBearSweptLevel,
                             sweptLevelStartBar = pendingBearSweptStartBar,
                             breakerStartIdx = bar_index - startOffset,
                             breakerEndIdx = bar_index - endOffset,
                             breakerTop = breakerT,
                             breakerBottom = breakerB,
                             isConfirmed = true,
                             confIndex = bar_index,
                             entryPrice = breakerB,
                             invalidationPrice = invPrice,
                             isInvalidated = false,
                             isTargetHit = false,
                             levelLine = na,
                             levelLabel = na,
                             breakerBox = na,
                             fvgBox = na,
                             targetLines = array.new_line(),
                             targetLabels = array.new_label(),
                             setupLabel = na
                             )

                        // Setup-linked level line (starts at exact extreme index, ends at sweepIndex)
                        int lineStartB = math.max(newBear.sweptLevelStartBar, bar_index - 4500)
                        newBear.levelLine := line.new(
                             x1 = lineStartB,
                             y1 = newBear.sweptLevel,
                             x2 = newBear.sweepIndex,
                             y2 = newBear.sweptLevel,
                             color = sweepLineColor,
                             style = f_getLineStyle(sweepLineStyle),
                             width = sweepLineWidth
                             )

                        newBear.levelLabel := label.new(
                             x = lineStartB,
                             y = newBear.sweptLevel + (nz(ta.atr(14)) * 0.1),
                             text = pendingBearSweptLabelText,
                             color = color.new(na, na),
                             textcolor = labelTextColor,
                             style = label.style_label_left,
                             size = f_getLabelSize(labelSizeStr),
                             text_font_family = font.family_monospace
                             )

                        newBear.breakerBox := box.new(
                             left = bar_index - endOffset,
                             top = newBear.breakerTop,
                             right = bar_index,
                             bottom = newBear.breakerBottom,
                             border_color = bearColorBorder,
                             bgcolor = bearColorActive,
                             xloc = xloc.bar_index
                             )

                        if hasFvg
                            newBear.fvgBox := box.new(
                                 left = fvgIdx,
                                 top = fvgT,
                                 right = fvgRightIdx,
                                 bottom = fvgB,
                                 border_color = color.new(na, na),
                                 bgcolor = bearFvgColor,
                                 xloc = xloc.bar_index
                                 )

                        labelText = hasFvg ? "-Unicorn" : "-Breaker"
                        tooltipText = "Setup: " + (hasFvg ? "Bearish Unicorn" : "Bearish Breaker") + "\n" +
                                     "Swept Level: " + str.tostring(newBear.sweptLevel, format.mintick) + "\n" +
                                     "Entry: " + str.tostring(newBear.entryPrice, format.mintick) + "\n" +
                                     "Stop Loss: " + str.tostring(newBear.invalidationPrice, format.mintick)

                        newBear.setupLabel := label.new(
                             x = bar_index,
                             y = (newBear.breakerTop + newBear.breakerBottom) / 2.0,
                             text = labelText,
                             color = color.new(na, na),
                             textcolor = labelTextColor,
                             style = label.style_label_right,
                             size = f_getLabelSize(labelSizeStr),
                             tooltip = tooltipText,
                             text_font_family = font.family_monospace
                             )

                        if anyConfluenceOn
                            label.set_tooltip(newBear.setupLabel, tooltipText + "\nConfluence: " + f_confluenceTagText(false))

                        primaryTargetPrice = newBear.entryPrice - rrRatio * riskRange
                        if showRRTarget
                            l = line.new(
                                 x1 = newBear.breakerEndIdx,
                                 y1 = primaryTargetPrice,
                                 x2 = newBear.confIndex,
                                 y2 = primaryTargetPrice,
                                 color = labelTextColor,
                                 style = f_getLineStyle(projLineStyle),
                                 width = projLineWidth
                                 )
                            lbl = label.new(
                                 x = newBear.confIndex,
                                 y = primaryTargetPrice,
                                 text = str.tostring(rrRatio, "#.##") + "R",
                                 color = color.new(na, na),
                                 textcolor = labelTextColor,
                                 style = label.style_label_left,
                                 size = f_getLabelSize(labelSizeStr),
                                 tooltip = "Target level: " + str.tostring(primaryTargetPrice, format.mintick),
                                 text_font_family = font.family_monospace
                                 )
                            array.push(newBear.targetLines, l)
                            array.push(newBear.targetLabels, lbl)

                        if showAddTargets
                            tgts = f_parseTargets(addTargetsStr)
                            if array.size(tgts) > 0
                                for i = 0 to array.size(tgts) - 1
                                    m = array.get(tgts, i)
                                    tgtVal = newBear.entryPrice - m * riskRange
                                    l = line.new(
                                         x1 = newBear.breakerEndIdx,
                                         y1 = tgtVal,
                                         x2 = newBear.confIndex,
                                         y2 = tgtVal,
                                         color = labelTextColor,
                                         style = f_getLineStyle(projLineStyle),
                                         width = projLineWidth
                                         )
                                    lbl = label.new(
                                         x = newBear.confIndex,
                                         y = tgtVal,
                                         text = str.tostring(m, "#.##") + "R",
                                         color = color.new(na, na),
                                         textcolor = labelTextColor,
                                         style = label.style_label_left,
                                         size = f_getLabelSize(labelSizeStr),
                                         tooltip = "Target level: " + str.tostring(tgtVal, format.mintick),
                                         text_font_family = font.family_monospace
                                         )
                                    array.push(newBear.targetLines, l)
                                    array.push(newBear.targetLabels, lbl)

                        array.push(activeSetups, newBear)

                        if enableAlerts and alertActivation
                            alert("Activation: Bearish Breaker activated on " + syminfo.ticker + " at " + str.tostring(newBear.entryPrice), alert.freq_once_per_bar_close)

                        pendingBearSweepIdx := na
                        pendingBearFirstSweepBar := na

// 4. Update Existing Active Setups
if array.size(activeSetups) > 0
    for idx = array.size(activeSetups) - 1 to 0
        setup = array.get(activeSetups, idx)

        if not setup.isInvalidated and not setup.isTargetHit
            // Invalidation checks
            bool invHit = false
            if setup.dir == "BULL"
                if low < setup.invalidationPrice
                    invHit := true
            else
                if high > setup.invalidationPrice
                    invHit := true

            if invHit
                setup.isInvalidated := true
                if enableAlerts and alertInvalidation
                    alert("Invalidation Hit: Setup " + setup.dir + " invalidated on " + syminfo.ticker, alert.freq_once_per_bar_close)

                if discardInvalidated
                    line.delete(setup.levelLine)
                    label.delete(setup.levelLabel)
                    box.delete(setup.breakerBox)
                    if not na(setup.fvgBox)
                        box.delete(setup.fvgBox)
                    label.delete(setup.setupLabel)
                    for l in setup.targetLines
                        line.delete(l)
                    for lb in setup.targetLabels
                        label.delete(lb)
                    array.remove(activeSetups, idx)
                    continue
                else
                    box.set_border_color(setup.breakerBox, setup.dir == "BULL" ? bullColorInactive : bearColorInactive)
                    box.set_bgcolor(setup.breakerBox, setup.dir == "BULL" ? bullColorInactive : bearColorInactive)
                    if not na(setup.fvgBox)
                        box.set_bgcolor(setup.fvgBox, setup.dir == "BULL" ? bullColorInactive : bearColorInactive)
                    label.set_textcolor(setup.setupLabel, setup.dir == "BULL" ? bullColorInactive : bearColorInactive)

                    for l in setup.targetLines
                        line.delete(l)
                    for lb in setup.targetLabels
                        label.delete(lb)
                    array.clear(setup.targetLines)
                    array.clear(setup.targetLabels)
            else
                // Extend breaker box only (FVG and targets are static)
                box.set_right(setup.breakerBox, bar_index)
                label.set_x(setup.setupLabel, bar_index)

                // Track targets hit (primary target)
                float targetPrice = setup.dir == "BULL" ?
                     (setup.entryPrice + rrRatio * (setup.entryPrice - setup.invalidationPrice)) :
                     (setup.entryPrice - rrRatio * (setup.invalidationPrice - setup.entryPrice))

                bool hit = false
                if setup.dir == "BULL"
                    if high >= targetPrice
                        hit := true
                else
                    if low <= targetPrice
                        hit := true

                if hit
                    setup.isTargetHit := true
                    if enableAlerts and alertTarget
                        alert("Target Reached: Setup " + setup.dir + " target reached at " + str.tostring(targetPrice), alert.freq_once_per_bar_close)

// 5. Handle Setup History Limit
while array.size(activeSetups) > historyCount
    oldSetup = array.shift(activeSetups)
    line.delete(oldSetup.levelLine)
    label.delete(oldSetup.levelLabel)
    box.delete(oldSetup.breakerBox)
    if not na(oldSetup.fvgBox)
        box.delete(oldSetup.fvgBox)
    label.delete(oldSetup.setupLabel)
    for l in oldSetup.targetLines
        line.delete(l)
    for lb in oldSetup.targetLabels
        label.delete(lb)

// ========================================
// POTENTIAL BREAKER ALERT (ON UNCONFIRMED BAR)
// ========================================
var int lastPotentialAlertBar = na
if alertPotential and barstate.isrealtime and not barstate.isconfirmed and bar_index != lastPotentialAlertBar
    if not na(pendingBullSweepIdx)
        sweepOffset = bar_index - pendingBullSweepIdx
        [startOff, endOff] = f_findUpCandlesSeries(sweepOffset)
        if not na(startOff)
            [bTop, bBtm] = f_getSeriesRange(startOff, endOff)
            if close > bTop and bBtm >= pendingBullSweepExtreme
                alert("Potential Breaker: Potential Bullish Breaker forming on " + syminfo.ticker, alert.freq_once_per_bar)
                lastPotentialAlertBar := bar_index

    if not na(pendingBearSweepIdx)
        sweepOffset = bar_index - pendingBearSweepIdx
        [startOff, endOff] = f_findDownCandlesSeries(sweepOffset)
        if not na(startOff)
            [bTop, bBtm] = f_getSeriesRange(startOff, endOff)
            if close < bBtm and bTop <= pendingBearSweepExtreme
                alert("Potential Breaker: Potential Bearish Breaker forming on " + syminfo.ticker, alert.freq_once_per_bar)
                lastPotentialAlertBar := bar_index

// ========================================
// DASHBOARD RENDERING & DYNAMIC INVAL SYNC
// ========================================

// Extract latest active (non-invalidated, non-target hit) setup details dynamically
string showSetupDir = "NONE"
float showEntryPrice = na
float showInvalidationPrice = na
float showTargetPrice = na
float showRiskUsd = na
float showPositionSizeVal = na

if array.size(activeSetups) > 0
    for i = array.size(activeSetups) - 1 to 0
        s = array.get(activeSetups, i)
        if not s.isInvalidated and not s.isTargetHit
            showSetupDir := s.dir == "BULL" ? "BULLISH" : "BEARISH"
            showEntryPrice := s.entryPrice
            showInvalidationPrice := s.invalidationPrice
            if array.size(s.targetLines) > 0
                showTargetPrice := line.get_y1(array.get(s.targetLines, 0))
            else
                showTargetPrice := s.entryPrice + (s.dir == "BULL" ? 1 : -1) * rrRatio * math.abs(s.entryPrice - s.invalidationPrice)

            showRiskUsd := riskType == "Percentage" ? (accountBalance * riskAmount / 100.0) : riskAmount
            showPositionSizeVal := calculatePositionSize(showEntryPrice, showInvalidationPrice, showRiskUsd)
            break

var table dashboardTable = table.new(
     position = f_getTablePosition(dashboardPosition),
     columns = 3,
     rows = 20,
     bgcolor = tableBgColor,
     border_width = tableBorderWidth,
     border_color = tableBorderColor,
     frame_color = tableFrameColor,
     frame_width = tableFrameWidth
     )

if barstate.islast and showDashboard
    tSize = f_getTableTextSize(dashboardSize)

    // Header
    table.cell(dashboardTable, 0, 0, "Unicorn Model", bgcolor=tableHeaderBgColor, text_color=tableHeaderTextColor, text_size=tSize, text_font_family=font.family_monospace)
    table.merge_cells(dashboardTable, 0, 0, 2, 0)

    // Stats Rows
    table.cell(dashboardTable, 0, 1, "Bias:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
    table.cell(dashboardTable, 1, 1, biasSelect, text_color=biasSelect == "Neutral" ? color.orange : (biasSelect == "Bullish" ? color.green : color.red), text_size=tSize, text_font_family=font.family_monospace)
    table.cell(dashboardTable, 2, 1, "", text_size=tSize)

    table.cell(dashboardTable, 0, 2, "Unicorn Mode:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
    table.cell(dashboardTable, 1, 2, unicornMode ? "ENABLED" : "DISABLED", text_color=unicornMode ? color.green : color.gray, text_size=tSize, text_font_family=font.family_monospace)
    table.cell(dashboardTable, 2, 2, "", text_size=tSize)

    table.cell(dashboardTable, 0, 3, "Liquidity Source:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
    activeSrcs = ""
    if useA_resolved
        activeSrcs := activeSrcs + "A "
    if useB_resolved
        activeSrcs := activeSrcs + "B "
    if useC_resolved
        activeSrcs := activeSrcs + "C "
    if useD_resolved
        activeSrcs := activeSrcs + "D "
    table.cell(dashboardTable, 1, 3, activeSrcs, text_color=color.orange, text_size=tSize, text_font_family=font.family_monospace)
    table.cell(dashboardTable, 2, 3, "(" + htfMode + ")", text_color=color.gray, text_size=tSize, text_font_family=font.family_monospace)

    table.cell(dashboardTable, 0, 4, "Invalidation:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
    table.cell(dashboardTable, 1, 4, useSwingInvalidation ? "Swing Extreme" : "Breaker Extreme", text_color=color.orange, text_size=tSize, text_font_family=font.family_monospace)
    table.cell(dashboardTable, 2, 4, "", text_size=tSize)

    table.cell(dashboardTable, 0, 5, "Size Filter:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
    filterDesc = sizeFilterMode == "Filtered" ? str.tostring(minBreakerSize) + "-" + str.tostring(maxBreakerSize) + " " + breakerSizeUnit : "DISABLED"
    table.cell(dashboardTable, 1, 5, filterDesc, text_color=sizeFilterMode == "Filtered" ? color.green : color.gray, text_size=tSize, text_font_family=font.family_monospace)
    table.cell(dashboardTable, 2, 5, "", text_size=tSize)

    table.cell(dashboardTable, 0, 6, "Time Filter:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
    table.cell(dashboardTable, 1, 6, enableTimeFilter ? "ENABLED" : "DISABLED", text_color=enableTimeFilter ? color.green : color.gray, text_size=tSize, text_font_family=font.family_monospace)
    table.cell(dashboardTable, 2, 6, "", text_size=tSize)

    // Latest Setup Section
    table.cell(dashboardTable, 0, 7, "── LATEST SETUP ──", bgcolor=tableHeaderBgColor, text_color=tableHeaderTextColor, text_size=tSize, text_font_family=font.family_monospace)
    table.merge_cells(dashboardTable, 0, 7, 2, 7)

    if showSetupDir != "NONE"
        table.cell(dashboardTable, 0, 8, "Direction:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
        table.cell(dashboardTable, 1, 8, showSetupDir, text_color=showSetupDir == "BULLISH" ? color.green : color.red, text_size=tSize, text_font_family=font.family_monospace)
        table.cell(dashboardTable, 2, 8, "", text_size=tSize)

        table.cell(dashboardTable, 0, 9, "Entry Price:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
        table.cell(dashboardTable, 1, 9, str.tostring(showEntryPrice, format.mintick), text_color=tableTextColor, text_size=tSize, text_font_family=font.family_monospace)
        table.cell(dashboardTable, 2, 9, "", text_size=tSize)

        table.cell(dashboardTable, 0, 10, "Invalidation:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
        table.cell(dashboardTable, 1, 10, str.tostring(showInvalidationPrice, format.mintick), text_color=color.red, text_size=tSize, text_font_family=font.family_monospace)
        table.cell(dashboardTable, 2, 10, "", text_size=tSize)

        table.cell(dashboardTable, 0, 11, "Target (" + str.tostring(rrRatio, "#.##") + "R):", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
        table.cell(dashboardTable, 1, 11, str.tostring(showTargetPrice, format.mintick), text_color=color.green, text_size=tSize, text_font_family=font.family_monospace)
        table.cell(dashboardTable, 2, 11, "", text_size=tSize)

        if showPositionSize and not na(showPositionSizeVal)
            table.cell(dashboardTable, 0, 12, "Size:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
            table.cell(dashboardTable, 1, 12, formatPositionSize(showPositionSizeVal), text_color=color.aqua, text_size=tSize, text_font_family=font.family_monospace)
            table.cell(dashboardTable, 2, 12, "", text_size=tSize)
        else
            table.cell(dashboardTable, 0, 12, "", text_size=tSize)
            table.cell(dashboardTable, 1, 12, "", text_size=tSize)
            table.cell(dashboardTable, 2, 12, "", text_size=tSize)
    else
        table.cell(dashboardTable, 0, 8, "No active setups detected.", text_color=color.gray, text_size=tSize, text_font_family=font.family_monospace)
        table.merge_cells(dashboardTable, 0, 8, 2, 8)
        for r = 9 to 12
            table.cell(dashboardTable, 0, r, "", text_size=tSize)
            table.merge_cells(dashboardTable, 0, r, 2, r)

    // ── CONFLUENCE section - only rendered when at least one confluence filter is enabled,
    // so with all three off the dashboard is identical to the original.
    if anyConfluenceOn
        table.cell(dashboardTable, 0, 13, "── CONFLUENCE ──", bgcolor=tableHeaderBgColor, text_color=tableHeaderTextColor, text_size=tSize, text_font_family=font.family_monospace)
        table.merge_cells(dashboardTable, 0, 13, 2, 13)

        int confRow = 14
        if requireHtfFvg
            bool fvgBull = f_htfFvgGateOK(true)
            bool fvgBear = f_htfFvgGateOK(false)
            table.cell(dashboardTable, 0, confRow, "HTF FVG:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
            table.cell(dashboardTable, 1, confRow, (fvgBull ? "↑✓" : "↑✕") + " " + (fvgBear ? "↓✓" : "↓✕"), text_color=(fvgBull or fvgBear) ? color.green : color.gray, text_size=tSize, text_font_family=font.family_monospace)
            table.cell(dashboardTable, 2, confRow, "(" + htfFvgDelivery + "·" + (htfFvgConfluenceMode == "All Enabled Timeframes" ? "All" : "Any") + ")", text_color=color.gray, text_size=tSize, text_font_family=font.family_monospace)
            confRow += 1

            table.cell(dashboardTable, 0, confRow, "  ↑ TFs:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
            table.cell(dashboardTable, 1, confRow, f_htfTfStatusText(true), text_color=tableTextColor, text_size=tSize, text_font_family=font.family_monospace)
            table.cell(dashboardTable, 2, confRow, "", text_size=tSize)
            confRow += 1

            table.cell(dashboardTable, 0, confRow, "  ↓ TFs:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
            table.cell(dashboardTable, 1, confRow, f_htfTfStatusText(false), text_color=tableTextColor, text_size=tSize, text_font_family=font.family_monospace)
            table.cell(dashboardTable, 2, confRow, "", text_size=tSize)
            confRow += 1

        if requireSessionLiq
            bool sessBull = f_sessionGateOK(true)
            bool sessBear = f_sessionGateOK(false)
            table.cell(dashboardTable, 0, confRow, "Session Liq:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
            table.cell(dashboardTable, 1, confRow, (sessBull ? "↑✓" : "↑✕") + " " + (sessBear ? "↓✓" : "↓✕"), text_color=(sessBull or sessBear) ? color.green : color.gray, text_size=tSize, text_font_family=font.family_monospace)
            table.cell(dashboardTable, 2, confRow, str.tostring(sessionSweepWindow) + "b", text_color=color.gray, text_size=tSize, text_font_family=font.family_monospace)
            confRow += 1

        if requireVolume
            bool volOK = not na(lastVolSpikeBar) and (bar_index - lastVolSpikeBar) <= volumeConfWindow
            table.cell(dashboardTable, 0, confRow, "Volume:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
            table.cell(dashboardTable, 1, confRow, volOK ? "✓" : "✕", text_color=volOK ? color.green : color.gray, text_size=tSize, text_font_family=font.family_monospace)
            table.cell(dashboardTable, 2, confRow, na(lastVolSpikeBar) ? "no spike" : (str.tostring(bar_index - lastVolSpikeBar) + "b ago"), text_color=color.gray, text_size=tSize, text_font_family=font.family_monospace)
            confRow += 1
