//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  Unicorn Model + HTF FVG Context
//
//  Two indicators merged into one, with a strict division of labour:
//
//    • The Unicorn Model is the signal engine and is reproduced verbatim. Every
//      condition, calculation, drawing, alert and input behaves exactly as it
//      does in the standalone script.
//    • The Multi-Timeframe FVG engine is reproduced as a context layer that sits
//      *around* the Unicorn, never inside it. It answers one question and hands
//      the answer over read-only: has price recently tapped a HTF FVG in this
//      direction?
//
//  A Unicorn becomes QUALIFIED when, in order:
//      1. a HTF FVG exists,
//      2. price taps it,
//      3. the Unicorn Model confirms a same-direction Unicorn,
//      4. all within the configured interaction window.
//
//  "Only Show Qualified Setups?" (on by default once the layer is enabled)
//  removes setups that fail that test from the chart entirely. Turn it off to
//  keep every setup the Unicorn Model confirms and merely mark the qualified
//  ones. Either way the engine's decisions are identical — the switch only
//  governs what is displayed.
//
//  Sequencing is structural, not checked after the fact: the tap timestamp can
//  only ever be written on the bar the tap happened, and the FVG layer runs
//  above the Unicorn engine in this file, so a tap occurring after a Unicorn can
//  never retroactively qualify it.
//
//  With "Enable HTF FVG Context?" off, this script is the original Unicorn
//  Model: no FVG zones, no FVG state, no extra alerts, no qualified markers.
//
//  ── PASS 1 OPTIMIZATION ─────────────────────────────────────────────────────
//  Performance-only rework of the historical scanning. No trading logic, input,
//  drawing, alert or threshold was changed, and no lookback was shortened. Four
//  changes, each marked "PASS 1" at its site with the equivalence argument:
//
//    1. LTF FVG REGISTRY      — the 101-bar FVG rescan with its nested
//                               mitigation rescan is replaced by an incrementally
//                               maintained set of unmitigated gaps.
//    2. BREAKER GEOMETRY CACHE — the 41-bar breaker-run scan is anchored to the
//                               pending sweep bar, so it is computed once per
//                               sweep leg instead of once per bar per direction.
//    3. Single ATR(14) instance shared by all call sites.
//    4. Session filter evaluated once per bar; targets string parsed once.
//
//  ── PASS 2 OPTIMIZATION ─────────────────────────────────────────────────────
//  HTF liquidity state, arrays and drawing-object lifecycle. Again performance
//  only: no signal logic, no qualification sequencing, no visual output changed.
//
//    1. f_registerLevel     — the origin search and the prior-breach scan are
//                             fused into one backward pass over the same 1000
//                             bars, roughly halving the worst case.
//    2. Sweep loop early-out — cached min/max level bounds let the per-bar
//                             100-element scan be skipped on bars where no
//                             level can possibly be reached.
//    3. pendingRef          — per-slot direct object reference replaces the
//                             findById() linear scan (live-FVG mode).
//    4. Dashboard           — the duplicated latest-setup scan is gone.
//    5. Audited: every setup teardown path deletes all seven of its drawing
//       objects; every array has a stated bound. Two retention issues that
//       cannot be fixed without changing what you see are proposed, not
//       applied — see the Pass 2 notes.
//
//  ── PASS 3 VALIDATION ───────────────────────────────────────────────────────
//  Differential audit of this file against the original reference, plus the two
//  fixes that audit turned up. No architectural change.
//
//    1. Removed the `pendingId` slot array — dead since Pass 2 replaced
//       findById() with a direct reference; written on three paths, read on none.
//    2. Explicitly typed the na written into the `pendingRef` object array at
//       both clear sites, rather than relying on inference for a bare na.
//
//  One deliberate deviation from the original remains, introduced in Pass 1 and
//  carried forward knowingly: the five conditionally-evaluated ta.atr(14)
//  instances are now one always-evaluated series. This is inert on default
//  settings and only observable with "Enable FVG ATR Filter" or the ATR-unit
//  breaker size filter switched on, where the new value is the correct one.
// ─────────────────────────────────────────────────────────────────────────────
indicator("Unicorn Model + HTF FVG", shorttitle="UM+FVG", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ========================================
// USER DEFINED TYPES
// ========================================
type HTFLevel
    string tfLabel      // e.g. "4H", "1H"
    string levelType    // "Swing" or "OHLC"
    bool isHigh         // true = High / false = Low
    float price
    int startBar
    bool isSwept
    int sweepBar
    string labelText

type Setup
    string dir                // "BULL" or "BEAR"
    int sweepIndex            // Bar index of the sweep extreme
    float sweepExtreme        // Highest high or lowest low of the sweep leg
    float sweptLevel          // The HTF liquidity level that was swept
    int sweptLevelStartBar   // Bar index when the swept level was formed
    int breakerStartIdx       // Start bar index of the breaker candles series
    int breakerEndIdx         // End bar index of the breaker candles series
    float breakerTop          // Max high of the breaker candles series
    float breakerBottom       // Min low of the breaker candles series
    bool isConfirmed          // Confirmed yet?
    int confIndex             // Bar index of confirmation
    float entryPrice          // Price at confirmation (close)
    float invalidationPrice   // Invalidation level
    bool isInvalidated        // Has it been invalidated?
    bool isTargetHit          // Has target been hit?
    line levelLine            // Dotted level line drawn when setup confirmed
    label levelLabel          // Text label at origin of level line
    box breakerBox            // Box drawing for breaker
    box fvgBox                // Box drawing for FVG
    line[] targetLines        // Array of lines for target projections
    label[] targetLabels      // Array of labels for targets
    label setupLabel          // Monospaced text label (+Unicorn / -Breaker)
    // Setup Grade factors, recorded on the confirmation bar so the dashboard
    // grades the setup as it was when it fired rather than as the chart looks
    // now. Nothing here feeds back into the engine.
    bool factorSweep          // Took out a HTF liquidity level
    bool factorHtfFvg         // Confirmed inside a HTF FVG interaction window
    bool factorLtfFvg         // Breaker overlaps an LTF FVG (a true Unicorn)
    bool factorVolume         // Confirmation-bar volume exceeded its average

// PASS 1 — one entry per LTF (chart-timeframe) fair value gap that is still
// unmitigated. This is the incremental replacement for the historical rescan
// that f_findBullishFVG / f_findBearishFVG used to perform on every call; see
// the LTF FVG REGISTRY section for the equivalence argument.
type LtfFvg
    float top                 // Gap top    (bull: low[i]      / bear: low[i+2])
    float bot                 // Gap bottom (bull: high[i+2]   / bear: high[i])
    int   thirdBar            // bar_index of the 3rd candle of the pattern
    float atrAtForm           // ATR(14) on thirdBar, frozen for the ATR filter

// ========================================
// GLOBAL STATE ARRAYS (Defined before functions)
// ========================================
var HTFLevel[] activeHTFLevels = array.new<HTFLevel>()
var Setup[] activeSetups = array.new<Setup>()

// PASS 2 — sweep-loop early-out bounds for activeHTFLevels.
//   slot 0 = lowest  price among unswept isHigh levels
//   slot 1 = highest price among unswept isLow  levels
// A bar can only sweep something if high >= slot 0 or low <= slot 1, so when
// neither holds the 100-element scan below can be skipped whole. Held in an
// array because Pine functions may mutate a global object but may not reassign
// a global variable, and f_registerLevel has to update these on push.
//
// Staleness is safe by construction and in one direction only: every path that
// ADDS a level tightens the bounds at the push site, while paths that REMOVE
// one (the sweep itself, the 100-level trim) can only leave the bounds too
// permissive — which costs an unnecessary scan, never a missed sweep.
var float[] lvlBounds = array.new_float(2, na)

// PASS 1 — unmitigated LTF FVG registries, oldest first. Maintained once per
// bar; read (never written) by the FVG lookup functions.
var LtfFvg[] ltfBullFvgs = array.new<LtfFvg>()
var LtfFvg[] ltfBearFvgs = array.new<LtfFvg>()

// ========================================
// HTF FVG ENGINE - TYPES & STATE (from FVG Multi-Timeframe)
// ========================================
// ─── Types & state ───────────────────────────────────────────────────────────
type Fvg
    int    id
    box    bx
    label  lb
    float  top
    float  bot
    bool   bull
    bool   entered
    string tfLabel
    // Left edge of the gap, kept on the object so a zone can still be drawn
    // later from a gap that was never drawn when it formed.
    int    leftTime
    // PASS 2 — timeframe slot this gap belongs to, so the maintenance loop can
    // clear the slot's pending reference when the gap stops being tracked.
    int    slot

var array<Fvg> fvgs      = array.new<Fvg>()
// Left-edge time of the most recent gap drawn per slot — guards against redrawing
// the same gap on every chart bar inside one source-timeframe bar.
var array<int> lastLeft  = array.new_int(5, 0)
// PASS 3 — the `pendingId` slot array is gone. Once Pass 2 replaced findById()
// with a direct reference, nothing ever read those ids again; they were written
// on three paths and consumed on none. Removing dead state, not behaviour.
//
// PASS 2 — direct reference to the still-unconfirmed gap per slot, replacing the
// id -> linear-scan lookup findById() used to perform once per slot per bar.
//
// Equivalence rests on one invariant: this slot holds a gap if and only if that
// gap is still in `fvgs`. Both removal paths clear it — the fill branch of the
// maintenance loop (matched on id, so a slot already reused by a newer gap is
// left alone) and processSlot's own drop path. So a read here returns exactly
// what findById would have: the object while it is tracked, na once it is not.
var array<Fvg> pendingRef = array.new<Fvg>(5)
// Id counter. Held in an array because Pine functions may mutate a global object
// but may not reassign a global variable.
var array<int> idSeq = array.new_int(1, 0)

chartSec = timeframe.in_seconds()
chartMs  = chartSec * 1000

// PASS 1 — the script's single ATR(14) instance.
//
// The reference implementation instantiated ta.atr(14) in five separate places,
// every one of them inside a conditional branch (the two FVG finders, the size
// filter and the two level-label offsets). A ta.* series only advances on bars
// where its branch executes, so those five instances each carried their own
// partially-updated state. Declaring it once at global scope evaluates it on
// every bar, which is both cheaper and the value ATR(14) is defined to have.
//
// This is the one place in Pass 1 where output can differ from the reference,
// and only when "Enable FVG ATR Filter" or the ATR-unit breaker size filter is
// switched on — both are off by default. See the change log for detail.
float atr14 = ta.atr(14)

// ========================================
// GLOBAL USER FUNCTIONS (Defined next)
// ========================================

// Convert TF to label dynamically using seconds
f_getTFLabel(string tf) =>
    seconds = timeframe.in_seconds(tf)
    res = ""
    if seconds < 60
        res := str.tostring(seconds) + "S"
    else if (seconds / 60) < 60
        res := str.tostring(math.round(seconds / 60)) + "m"
    else if (seconds / 3600) < 24
        res := str.tostring(math.round(seconds / 3600)) + "H"
    else if (seconds / 86400) < 7
        res := str.tostring(math.round(seconds / 86400)) + "D"
    else if (seconds / 86400) < 30
        res := str.tostring(math.round(seconds / 604800)) + "W"
    else
        res := str.tostring(math.round(seconds / 2592000)) + "M"
    res

// Resolve standard TradingView timeframe strings corresponding to hierarchy indexes
f_getHTFByVal(idx) =>
    switch idx
        0 => "5"
        1 => "15"
        2 => "30"
        3 => "60"
        4 => "150"
        5 => "240"
        6 => "1D"
        7 => "720"
        8 => "1D"
        9 => "2D"
        10 => "W"
        11 => "4D"
        12 => "W"
        13 => "15D"
        14 => "45D"
        15 => "15W"
        16 => "15M"
        => "60"

// Automatic HTF selection mapping (Mirroring Chronology Hierarchy)
getAutoHTFs() =>
    int tf = timeframe.in_seconds()
    int k = 0
    if tf <= 15           // 15S and below → 5m
        k := 0
    else if tf <= 60      // 1m and below → 15m
        k := 1
    else if tf <= 180     // 3m and below → 30m
        k := 2
    else if tf <= 300     // 5m and below → 1H
        k := 3
    else if tf <= 600     // 10m and below → 2.5H (150m)
        k := 4
    else if tf <= 900     // 15m and below → 4H
        k := 5
    else if tf <= 1800    // 30m and below → 1D
        k := 6
    else if tf <= 2700    // 45m and below → 12H (720m)
        k := 7
    else if tf <= 3600    // 1H and below → 1D
        k := 8
    else if tf <= 7200    // 2H and below → 2D
        k := 9
    else if tf <= 14400   // 4H and below → 1W
        k := 10
    else if tf <= 21600   // 6H and below → 4D
        k := 11
    else if tf <= 43200   // 12H and below → 1W
        k := 12
    else if tf <= 86400   // 1D and below → 15D
        k := 13
    else if tf <= 259200  // 3D and below → 45D
        k := 14
    else if tf <= 604800  // 1W and below → 15W
        k := 15
    else if tf <= 2592000 // 1M and below → 15M
        k := 16
    else                  // 3M+ → 45M
        k := 17

    string resolvedA = k - 1 >= 0 ? f_getHTFByVal(k - 1) : ""
    string resolvedB = f_getHTFByVal(k)
    string resolvedC = f_getHTFByVal(k + 1)
    string resolvedD = f_getHTFByVal(k + 2)
    [resolvedA, resolvedB, resolvedC, resolvedD]

// Parse comma separated values to array of floats
f_parseTargets(string s) =>
    float[] tgts = array.new_float()
    string cur = ""
    for i = 0 to str.length(s) - 1
        char = str.substring(s, i, i + 1)
        if char == ","
            val = str.tonumber(cur)
            if not na(val)
                array.push(tgts, val)
            cur := ""
        else
            if char != " "
                cur := cur + char
    if str.length(cur) > 0
        val = str.tonumber(cur)
        if not na(val)
            array.push(tgts, val)
    tgts

// Convert text size parameter to Pine size constant
f_getLabelSize(string sz) =>
    switch sz
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.small

// Convert text style parameter to Pine style constant
f_getLineStyle(string st) =>
    switch st
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_dotted

// Convert table text size parameter to Pine size constant
f_getTableTextSize(string sz) =>
    switch sz
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        "large"  => size.large
        "huge"   => size.huge
        => size.tiny

// Convert table position string to position constant
f_getTablePosition(string pos) =>
    switch pos
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right"  => position.bottom_right
        => position.top_right

// Swing points definition helper
f_getHTFData() =>
    hPrev = high[1]
    lPrev = low[1]
    isSwingHigh = high > high[1] and close < close[1]
    isSwingLow = low < low[1] and close > close[1]
    latestSH = ta.valuewhen(isSwingHigh, high, 0)
    latestSL = ta.valuewhen(isSwingLow, low, 0)
    [hPrev, lPrev, latestSH, latestSL]

// Find opposing candle runs
f_findDownCandlesSeries(sweepOffset) =>
    int startOffset = na
    int endOffset = na
    for i = sweepOffset to sweepOffset + 40
        if i >= bar_index
            break
        if close[i] < open[i]
            int tempEnd = i
            for j = i + 1 to i + 20
                if j >= bar_index
                    break
                if close[j] < open[j]
                    tempEnd := j
                else
                    break
            runLength = tempEnd - i + 1
            if runLength >= 2
                startOffset := i
                endOffset := tempEnd
                break
    [startOffset, endOffset]

f_findUpCandlesSeries(sweepOffset) =>
    int startOffset = na
    int endOffset = na
    for i = sweepOffset to sweepOffset + 40
        if i >= bar_index
            break
        if close[i] > open[i]
            int tempEnd = i
            for j = i + 1 to i + 20
                if j >= bar_index
                    break
                if close[j] > open[j]
                    tempEnd := j
                else
                    break
            runLength = tempEnd - i + 1
            if runLength >= 2
                startOffset := i
                endOffset := tempEnd
                break
    [startOffset, endOffset]

f_getSeriesRange(startOffset, endOffset) =>
    float maxH = na
    float minL = na
    for i = startOffset to endOffset
        maxH := na(maxH) ? high[i] : math.max(maxH, high[i])
        minL := na(minL) ? low[i] : math.min(minL, low[i])
    [maxH, minL]

// FVG Overlap Finders
//
// PASS 1 — these were a 101-bar rescan with a nested mitigation rescan inside
// it. They are now a walk over the unmitigated-FVG registry that the LTF FVG
// REGISTRY section maintains once per bar. The selection rule is unchanged, and
// the mapping is exact:
//
//   original offset i   <->   bar_index - f.thirdBar
//   original fTop/fBtm  <->   f.top / f.bot        (identical expressions)
//   original scan order <->   newest -> oldest     (walk the array backwards)
//   original limit      <->   math.min(bar_index - startIdx, 100), unchanged
//   original mitigation <->   membership of the registry (mitigated gaps are
//                             removed on the bar they are mitigated, using the
//                             same low < bot / high > top test over the same
//                             bars the inner j-loop covered)
//   original fvgIdx     <->   f.thirdBar - 1
//   original right edge <->   f.thirdBar
//
// The `break` on i > limit is safe because the walk visits gaps in strictly
// increasing i, so everything beyond the first out-of-window gap is also out of
// window. Gaps that fail the ATR filter are skipped without ending the search,
// exactly as the original `continue` did.
f_findBullishFVG(breakerT, breakerB, startIdx, enableFvgAtrFilter, fvgAtrMult) =>
    float fvgT = na
    float fvgB = na
    int fvgIdx = na
    int fvgRightIdx = na
    int limit = math.min(bar_index - startIdx, 100)
    if limit >= 0 and array.size(ltfBullFvgs) > 0
        for k = array.size(ltfBullFvgs) - 1 to 0
            LtfFvg f = array.get(ltfBullFvgs, k)
            int i = bar_index - f.thirdBar
            if i > limit
                break
            if enableFvgAtrFilter and (f.top - f.bot) < (f.atrAtForm * fvgAtrMult)
                continue
            bool overlaps = math.max(f.bot, breakerB) < math.min(f.top, breakerT)
            if overlaps
                fvgT := f.top
                fvgB := f.bot
                fvgIdx := f.thirdBar - 1
                fvgRightIdx := f.thirdBar  // right boundary: the newer candle
                break
    [fvgT, fvgB, fvgIdx, fvgRightIdx]

f_findBearishFVG(breakerT, breakerB, startIdx, enableFvgAtrFilter, fvgAtrMult) =>
    float fvgT = na
    float fvgB = na
    int fvgIdx = na
    int fvgRightIdx = na
    int limit = math.min(bar_index - startIdx, 100)
    if limit >= 0 and array.size(ltfBearFvgs) > 0
        for k = array.size(ltfBearFvgs) - 1 to 0
            LtfFvg f = array.get(ltfBearFvgs, k)
            int i = bar_index - f.thirdBar
            if i > limit
                break
            if enableFvgAtrFilter and (f.top - f.bot) < (f.atrAtForm * fvgAtrMult)
                continue
            bool overlaps = math.max(f.bot, breakerB) < math.min(f.top, breakerT)
            if overlaps
                fvgT := f.top
                fvgB := f.bot
                fvgIdx := f.thirdBar - 1
                fvgRightIdx := f.thirdBar  // right boundary: the newer candle
                break
    [fvgT, fvgB, fvgIdx, fvgRightIdx]

// Size filter
f_checkSizeFilter(breakerTop, breakerBottom, sizeFilterMode, minBreakerSize, maxBreakerSize, breakerSizeUnit) =>
    bool pass = true
    if sizeFilterMode == "Filtered"
        float bSize = breakerTop - breakerBottom
        float checkSize = bSize
        if breakerSizeUnit == "Ticks"
            checkSize := bSize / syminfo.mintick
        else if breakerSizeUnit == "ATR"
            checkSize := bSize / atr14  // PASS 1: shared ATR instance
        if checkSize < minBreakerSize or checkSize > maxBreakerSize
            pass := false
    pass

// PASS 2 — origin bar + prior-breach test, fused into a single backward pass.
//
// The reference ran two separate scans back to back: f_findExtremeBar walked
// offsets 0..1000 newest-first looking for the bar that printed the level, and
// f_registerLevel then walked the bars *between* that bar and now looking for a
// prior breach. Both cover the same stretch of history, so one pass answers
// both questions.
//
// Range mapping, so the fusion is checkable rather than asserted. With the
// match found at offset iExt, the reference's breach loop ran over absolute bar
// indices [max(extBar + 1, bar_index - 999), bar_index - 1], which in offset
// terms is exactly [1, min(iExt - 1, 999)]:
//
//   • offset 0 is excluded — the match test is evaluated first at every offset,
//     so the matching bar itself is never treated as a breach, and neither is
//     the current bar when it is the match;
//   • the 999 cap is the reference's own bar_index - 999 floor;
//   • the reference's breach loop broke on the first (oldest) breach while this
//     one records the newest; only the boolean is consumed, so both agree.
//
// When no match is found the reference skipped the breach test altogether and
// registered the level regardless of history. That fallback is preserved
// verbatim — see the note in f_registerLevel for why it is load-bearing.
//
// Bound is unchanged at 1000 offsets. This is a fusion, not a shortened
// lookback: worst case drops from ~2N to ~N over the identical bar range.
//
// The fused loop lives inline in f_registerLevel below rather than in its own
// helper: f_registerLevel was the only caller, and keeping it inline avoids
// returning a tuple out of one user function into another.

// Register active levels in memory (no visual rendering here)
//
// PASS 2 — the origin search and the prior-breach scan are now one call. Note
// that the "no origin found" fallback is deliberately untouched: when the level
// is older than 1000 chart bars (routinely the case for a Daily source on an
// intraday chart) the reference located no origin bar, skipped the breach test
// entirely and registered the level anyway. Capturing the true origin bar at
// creation time — as a pure state design would — would make the breach test
// always run and would therefore reject levels this engine currently accepts,
// changing which liquidity exists and so which setups fire. That is a signal
// change, so it is not made here. See the Pass 2 notes for the opt-in proposal.
//
// The duplicate scan is deliberately left after the breach test as well. It is
// bounded at 100 and is a small fraction of this function's cost, whereas
// hoisting it above the breach test would change behaviour for a level that is
// both already registered and already breached.
f_registerLevel(string tfLabel, string lvlType, bool isHigh, float priceVal) =>
    if not na(priceVal)
        int  extBar   = na
        bool breached = false
        for i = 0 to 1000
            if i >= bar_index
                break
            float checkVal = isHigh ? high[i] : low[i]
            if math.abs(checkVal - priceVal) < (syminfo.mintick * 0.1)
                extBar := bar_index - i
                break
            if i <= 999 and not breached
                if isHigh ? checkVal >= priceVal : checkVal <= priceVal
                    breached := true

        int startB = na(extBar) ? bar_index : extBar
        // A breach only counts when the origin bar was located, matching the
        // reference's `if not na(extBar) and ...` guard on its breach loop.
        bool alreadyBreached = na(extBar) ? false : breached

        if not alreadyBreached
            bool exists = false
            if array.size(activeHTFLevels) > 0
                for i = 0 to array.size(activeHTFLevels) - 1
                    lvl = array.get(activeHTFLevels, i)
                    if not lvl.isSwept and lvl.isHigh == isHigh and math.abs(lvl.price - priceVal) < (syminfo.mintick * 0.1)
                        string searchStr = tfLabel + " " + lvlType
                        if not str.contains(lvl.labelText, searchStr)
                            lvl.labelText := lvl.labelText + ", " + searchStr
                        exists := true
                        break

            if not exists
                string labelTxt = tfLabel + " " + lvlType
                HTFLevel newLvl = HTFLevel.new(
                     tfLabel = tfLabel,
                     levelType = lvlType,
                     isHigh = isHigh,
                     price = priceVal,
                     startBar = startB,
                     isSwept = false,
                     sweepBar = na,
                     labelText = labelTxt
                     )
                array.push(activeHTFLevels, newLvl)
                // PASS 2 — keep the sweep-loop bounds current. Held in an array
                // because a Pine function may mutate a global object but may not
                // reassign a global variable (same reason idSeq is an array).
                if isHigh
                    float curMin = array.get(lvlBounds, 0)
                    array.set(lvlBounds, 0, na(curMin) ? priceVal : math.min(curMin, priceVal))
                else
                    float curMax = array.get(lvlBounds, 1)
                    array.set(lvlBounds, 1, na(curMax) ? priceVal : math.max(curMax, priceVal))

// Position Sizing Calculations (From MTF MA Model)
getContractSize() =>
    ticker = syminfo.ticker
    if str.contains(ticker, "ES") or str.contains(ticker, "MES")
        50.0
    else if str.contains(ticker, "NQ") or str.contains(ticker, "MNQ")
        20.0
    else if str.contains(ticker, "YM") or str.contains(ticker, "MYM")
        5.0
    else if str.contains(ticker, "RTY") or str.contains(ticker, "M2K")
        50.0
    else if str.contains(ticker, "CL") or str.contains(ticker, "MCL")
        1000.0
    else if str.contains(ticker, "GC") or str.contains(ticker, "MGC")
        100.0
    else if str.contains(ticker, "SI") or str.contains(ticker, "SIL")
        5000.0
    else if str.contains(ticker, "BTC")
        1.0
    else if str.contains(ticker, "ETH")
        1.0
    else
        1.0

calculatePositionSize(float entry, float stop, float riskUsd) =>
    riskPerUnit = math.abs(entry - stop)
    positionSize = riskPerUnit != 0 ? riskUsd / riskPerUnit : 0

    detectedMarket = syminfo.type
    if detectedMarket == "forex"
        ticker = syminfo.ticker
        needsConversion = not (str.contains(ticker, "USD") and str.endswith(ticker, "USD")) or str.contains(ticker, "6")
        if needsConversion
            positionSize := (positionSize * entry) / 100000.0
        else
            positionSize := positionSize / 100000.0
    else if detectedMarket == "futures" or detectedMarket == "future" or detectedMarket == "cfd" or detectedMarket == "index"
        contractSize = getContractSize()
        positionSize := positionSize / contractSize

    positionSize

formatPositionSize(float size) =>
    detectedMarket = syminfo.type
    sizeText = ""
    if detectedMarket == "forex"
        sizeText := str.tostring(size, '#.##') + ' lots'
    else if detectedMarket == "futures" or detectedMarket == "future" or detectedMarket == "cfd" or detectedMarket == "index"
        sizeText := str.tostring(size, '#.##') + ' ct'
    else if detectedMarket == "crypto" or detectedMarket == "stock"
        sizeText := str.tostring(size, '#.####') + ' units'
    else
        sizeText := str.tostring(size, '#.####')
    sizeText

