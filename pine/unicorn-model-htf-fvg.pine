HTF_6_Settings.useForFilter := input.bool(false, "6", inline="flt", tooltip="Which of the six HTF FVG timeframe slots may validate a Unicorn. Defaults to slots 2/3/4 = 15m/1H/4H.", group=GRP_HTF_FLT)

// Slot labels are resolved here, from the inputs themselves, so the dashboard and
