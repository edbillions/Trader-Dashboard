	float middle
	float close
	bool mitigated
	int mitigated_time
	bool isbullish
	Box box2
	// --- HTF FVG FILTER: lifecycle state, tracked independently of the display
	// --- `mitigated` flag so display settings can never alter signal output.
	bool fltInteracted = false
