// ========================================
// INPUTS - Group 10: HTF FVG Filter
// ========================================
// Turns the HTF FVG engine below into a required higher-timeframe context
// filter for the Unicorn engine above. Directional match is deliberately NOT
// an input - a bullish Unicorn always requires a bullish HTF FVG.
string GRP_HTF_FLT = "HTF FVG Filter"
enableHtfFvgFilter = input.bool(true, "Require HTF FVG Context?", tooltip="When enabled, a Unicorn only fires if a direction-matched HTF FVG exists, price has interacted with it, and the delivery condition is met. When disabled the Unicorn engine behaves exactly as it did before the merge.", group=GRP_HTF_FLT)
htfRequireDelivery = input.bool(true, "Require Delivery?", tooltip="Interaction (price entering the gap) and delivery (price being delivered back out of it) are separate conditions. Disable to accept a bare interaction.", group=GRP_HTF_FLT, active=enableHtfFvgFilter)
htfDeliveryMode = input.string("Tap", "Delivery Definition", options=["Tap", "Close Outside FVG", "Close Beyond CE"], tooltip="Tap (default): delivering from the PD array means price reaching the HTF FVG, so the tap itself is the delivery. Close Outside FVG: stricter - a confirmed bar must close back beyond the far boundary. Close Beyond CE: a confirmed close back beyond the midpoint.", group=GRP_HTF_FLT, active=enableHtfFvgFilter and htfRequireDelivery)
htfRequireSweepInto = input.bool(true, "Require Sweep Into FVG?", tooltip="Associates a Unicorn with a specific FVG: the liquidity sweep that armed this setup must itself have reached into the gap. Prevents an unrelated older FVG from validating a new Unicorn.", group=GRP_HTF_FLT, active=enableHtfFvgFilter)
htfFreshnessBars = input.int(0, "FVG Freshness (chart bars, 0 = unlimited)", minval=0, tooltip="Maximum number of chart bars between the FVG interaction and Unicorn confirmation. 0 leaves it unbounded (the per-slot FVG count is then the practical ceiling).", group=GRP_HTF_FLT, active=enableHtfFvgFilter)
htfConsumeAfterSignal = input.bool(false, "Consume FVG After Signal?", tooltip="When enabled an HTF FVG can validate only one Unicorn signal. Off by default: an HTF FVG is context and may host several setups until it is invalidated.", group=GRP_HTF_FLT, active=enableHtfFvgFilter)
showFilterDebug = input.bool(false, "Show Filter Diagnostic?", tooltip="Adds a diagnostic section to the dashboard showing how far the last Unicorn candidate got through the filter, and which condition blocked it.", group=GRP_HTF_FLT)

// Which HTF FVG timeframe slots feed the filter. Slots themselves are configured
