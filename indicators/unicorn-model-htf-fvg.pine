htfFvgWindow = input.int(30, "Interaction Window (bars)", minval=0, maxval=1000, tooltip="How many chart bars a HTF FVG tap keeps qualifying same-direction Unicorns for. 0 means the Unicorn must confirm on the same bar as the tap. Note that the HTF FVG engine only builds gaps within its own 'Max bars back to find FVGs' setting, so qualification never reaches further back than that.", group=GRP_QUAL, active=enableHtfFvg)
