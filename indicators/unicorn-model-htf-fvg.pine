onlyQualifiedSetups = input.bool(true, "Only Show Qualified Setups?", tooltip="ON: a confirmed setup that did not follow a same-direction HTF FVG tap is removed from the chart along with its drawings, so only qualified Unicorns remain. OFF: every setup the Unicorn Model confirms stays on the chart exactly as it does today, and qualified ones are merely marked. Either way the Unicorn engine's own decisions are unchanged — this only controls what is displayed, and it has no effect at all while 'Enable HTF FVG Context?' is off. Note that the engine's 'Activation' alert still fires for setups hidden by this mode; use the 'Qualified Bullish/Bearish Unicorn' alerts instead when filtering.", group=GRP_QUAL, active=enableHtfFvg)
showQualifiedMarkers = input.bool(true, "Show Qualified Markers?", tooltip="Draw a diamond at the confirmation bar of every qualified Unicorn. The original Unicorn label, boxes and targets are unaffected either way.", group=GRP_QUAL, active=enableHtfFvg)
