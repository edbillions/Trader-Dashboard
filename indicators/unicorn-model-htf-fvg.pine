alertFvgTap = input.bool(false, "Alert on HTF FVG Tap?", tooltip="Fire the HTF FVG engine's own 'price entered FVG' alert() call. Off by default so that an 'Any alert() function call' alert keeps delivering exactly the Unicorn Model's own alerts.", group=GRP_QUAL, active=enableHtfFvg)

// ========================================
// INPUTS - Group 11: Diagnostics (NEW)
// ========================================
// Read-only instrumentation. Nothing here participates in a decision: every
// value it reports is recomputed from state the engine has already settled, and
// every label is drawn from an else-branch of a condition the engine had already
// evaluated. With it off the script is byte-for-byte the same engine.
string GRP_DBG = "Diagnostics"
debugMode = input.bool(false, "Show Rejection Diagnostics?", tooltip="Label every bar on which the Unicorn Model had a live sweep leg but did NOT confirm a setup, stating which gate rejected it and with what numbers. Use this to find out why a setup you expected on a given bar arrived later — the label on that bar names the gate.", group=GRP_DBG)
debugBars = input.int(100, "Diagnostics Lookback (bars)", minval=1, maxval=500, tooltip="Only label the most recent N bars. Labels share the 500-label budget with the Unicorn's own drawings, so keep this tight.", group=GRP_DBG, active=debugMode)
debugNoSweep = input.bool(false, "Also Label Bars With No Sweep Leg?", tooltip="Include bars where no liquidity sweep is pending at all, so 'nothing happened here' is distinguishable from 'a gate rejected it'. Noisy — usually only needed when a setup never appears at all.", group=GRP_DBG, active=debugMode)

// ========================================
// HTF FVG ENGINE - DETECTION & DRAWING HELPERS
// ========================================
// ─── Detection ───────────────────────────────────────────────────────────────
// Both are evaluated in the source timeframe's context and return
// [bullish, bearish, gap top, gap bottom, opening time of the middle candle].

// Pattern ending on the candle before the context's latest one.
detectClosed() =>
    bool  bull = low[1]  > high[3]
    bool  bear = high[1] < low[3]
    float top  = bull ? low[1]  : low[3]
    float bot  = bull ? high[3] : high[1]
    [bull, bear, top, bot, time[2]]

// Pattern ending on the context's latest candle.
detectLive() =>
    bool  bull = low  > high[2]
    bool  bear = high < low[2]
    float top  = bull ? low[0]  : low[2]
    float bot  = bull ? high[2] : high[0]
    [bull, bear, top, bot, time[1]]

// ─── Drawing helpers ─────────────────────────────────────────────────────────
borderStyleOf() =>
    switch borderStyle
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

labelSizeOf() =>
    switch labelSize
        "Tiny"   => size.tiny
        "Normal" => size.normal
        "Large"  => size.large
        => size.small

// Keeps the tag inside the box rather than centred on its edge.
labelX(int l, int r) =>
    int pad = int(math.max((r - l) * 0.08, 1))
    switch labelPosition
        "Left"   => l + pad
        "Center" => int(math.avg(l, r))
        => r - pad

createFvg(bool bull, float top, float bot, int leftTime, string tfLabel, int tfMs) =>
    // Never narrower than the three source candles that formed the gap, so a
    // high-timeframe box stays visible on a much lower chart timeframe.
    int   rightTime = leftTime + int(math.max(boxLength * chartMs, 2 * tfMs))
    // Drawing here is only for "All" mode. The gap is tracked either way, so
    // qualification is unaffected; in "Qualifying Only" mode the zone is drawn
    // later, by the qualification hook, from the geometry stored on this object.
    box   bx = na
    label lb = na
    if fvgZoneMode == "All"
        bx := box.new(leftTime, top, rightTime, bot, xloc = xloc.bar_time,
                 bgcolor      = bull ? bullBoxColor : bearBoxColor,
                 border_color = bull ? bullBorderColor : bearBorderColor,
                 border_width = borderWidth,
                 border_style = borderStyleOf())
        lb := label.new(labelX(leftTime, rightTime), math.avg(top, bot), tfLabel, xloc = xloc.bar_time,
                 style     = label.style_none,
                 textcolor = bull ? bullLabelColor : bearLabelColor,
                 size      = labelSizeOf())
    int id = array.get(idSeq, 0) + 1
    array.set(idSeq, 0, id)
    Fvg f = Fvg.new(id = id, bx = bx, lb = lb, top = top, bot = bot, bull = bull, entered = false, tfLabel = tfLabel, leftTime = leftTime)
    array.push(fvgs, f)
    f

findById(int id) =>
    Fvg res = na
    if id >= 0 and array.size(fvgs) > 0
        for i = 0 to array.size(fvgs) - 1
            Fvg f = array.get(fvgs, i)
            if f.id == id
                res := f
                break
    res

dropById(int id) =>
    if id >= 0 and array.size(fvgs) > 0
        for i = array.size(fvgs) - 1 to 0
            Fvg f = array.get(fvgs, i)
            if f.id == id
                // Guarded: outside "All" zone mode there is nothing drawn to delete.
                if not na(f.bx)
                    box.delete(f.bx)
                    label.delete(f.lb)
                array.remove(fvgs, i)
                break

// ─── Per-timeframe processing ────────────────────────────────────────────────
processSlot(int slot, bool enabled, string tfStr, string tfLabel, bool bullC, bool bearC, float topC, float botC, int leftC, bool bullL, bool bearL, float topL, float botL, int leftL) =>
    int tfSec = timeframe.in_seconds(tfStr)
    if enabled and not (hideLowerTf and tfSec < chartSec) and bar_index > last_bar_index - maxBarsBack
        bool  bull = waitForClose ? bullC : bullL
        bool  bear = waitForClose ? bearC : bearL
        float top  = waitForClose ? topC  : topL
        float bot  = waitForClose ? botC  : botL
        int   left = waitForClose ? leftC : leftL

        bool has  = bull or bear
        int  prev = array.get(lastLeft, slot)

        if has and not na(left) and left != prev
            Fvg f = createFvg(bull, top, bot, left, tfLabel, tfSec * 1000)
            array.set(lastLeft, slot, left)
            if not waitForClose
                array.set(pendingId, slot, f.id)
        else if not waitForClose and left == prev
            // Still inside the candle that produced this gap: track it as it develops.
            Fvg p = findById(array.get(pendingId, slot))
            if not na(p)
                if has
                    p.top := top
                    p.bot := bot
                    // Guarded: outside "All" zone mode there is no drawing to move,
                    // but the gap's bounds are still tracked above.
                    if not na(p.bx)
                        box.set_top(p.bx, top)
                        box.set_bottom(p.bx, bot)
                        label.set_y(p.lb, math.avg(top, bot))
                else
                    // The gap closed before the candle did — it never existed.
                    dropById(p.id)
                    array.set(pendingId, slot, -1)
                    array.set(lastLeft, slot, 0)


// ========================================
// MAX BARS BACK ALLOCATION (Resolves Replay Buffer limits error)
// ========================================
max_bars_back(high, 1000)
max_bars_back(low, 1000)
max_bars_back(close, 1000)
max_bars_back(open, 1000)

// ========================================
// SYSTEM VARIABLES & TIME RESOLUTION
// ========================================

// Pending Setup State Variables
var int pendingBullSweepIdx = na
var int pendingBullFirstSweepBar = na
var float pendingBullSweepExtreme = na
var float pendingBullSweptLevel = na
var int pendingBullSweptStartBar = na
var string pendingBullSweptLabelText = ""

var int pendingBearSweepIdx = na
var int pendingBearFirstSweepBar = na
var float pendingBearSweepExtreme = na
var float pendingBearSweptLevel = na
var int pendingBearSweptStartBar = na
var string pendingBearSweptLabelText = ""

// Time Filter Logic (Uses inputs, must be declared after them)
f_isInSession() =>
    bool inSess = false
    if not enableTimeFilter
        inSess := true
    else
        tz = customTimezone ? "GMT" + (tzHourOffset >= 0 ? "+" : "-") + str.tostring(math.abs(tzHourOffset), "00") + str.tostring(math.abs(tzMinOffset), "00") : syminfo.timezone
        s1 = session1Enable and not na(time(timeframe.period, session1Time, tz))
        s2 = session2Enable and not na(time(timeframe.period, session2Time, tz))
        s3 = session3Enable and not na(time(timeframe.period, session3Time, tz))
        inSess := s1 or s2 or s3
    inSess

// ========================================
// FETCHING DATA RESOLUTION
// ========================================
[autoTA, autoTB, autoTC, autoTD] = getAutoHTFs()

// Check if A is empty (e.g. on 15s chart resolution where k-1 < 0)
bool autoA_valid = autoTA != ""
string finalAutoTA = autoA_valid ? autoTA : timeframe.period

// Resolve final timeframes
htfA_resolved = htfMode == "Automatic" ? finalAutoTA : tfA
htfB_resolved = htfMode == "Automatic" ? autoTB : tfB
htfC_resolved = htfMode == "Automatic" ? autoTC : tfC
htfD_resolved = htfMode == "Automatic" ? autoTD : tfD

// Override the 'use' toggles in Automatic Mode if Source A is invalid
useA_resolved = useA and (htfMode == "Manual" or (htfMode == "Automatic" and autoA_valid))
useB_resolved = useB
useC_resolved = useC
useD_resolved = useD

// Request security for all sources
[prevH_A, prevL_A, sh_A, sl_A] = request.security(syminfo.tickerid, htfA_resolved, f_getHTFData(), barmerge.gaps_off, barmerge.lookahead_off)
[prevH_B, prevL_B, sh_B, sl_B] = request.security(syminfo.tickerid, htfB_resolved, f_getHTFData(), barmerge.gaps_off, barmerge.lookahead_off)
[prevH_C, prevL_C, sh_C, sl_C] = request.security(syminfo.tickerid, htfC_resolved, f_getHTFData(), barmerge.gaps_off, barmerge.lookahead_off)
[prevH_D, prevL_D, sh_D, sl_D] = request.security(syminfo.tickerid, htfD_resolved, f_getHTFData(), barmerge.gaps_off, barmerge.lookahead_off)


// Two requests per timeframe, because `lookahead` must be a compile-time constant:
//   • confirmed — lookahead_on with offset 1 always resolves to the last *closed*
//     source candle, on history and in realtime alike. This is the standard
//     non-repainting multi-timeframe idiom; no future data is read.
//   • live — lookahead_off with offset 0 gives the last closed candle on history
//     and the currently forming one in realtime, which is what lets an unconfirmed
//     gap be drawn as it forms.
[c1b, c1r, c1t, c1o, c1l] = request.security(syminfo.tickerid, tf1, detectClosed(), lookahead = barmerge.lookahead_on)
[l1b, l1r, l1t, l1o, l1l] = request.security(syminfo.tickerid, tf1, detectLive(), lookahead = barmerge.lookahead_off)
[c2b, c2r, c2t, c2o, c2l] = request.security(syminfo.tickerid, tf2, detectClosed(), lookahead = barmerge.lookahead_on)
[l2b, l2r, l2t, l2o, l2l] = request.security(syminfo.tickerid, tf2, detectLive(), lookahead = barmerge.lookahead_off)
[c3b, c3r, c3t, c3o, c3l] = request.security(syminfo.tickerid, tf3, detectClosed(), lookahead = barmerge.lookahead_on)
[l3b, l3r, l3t, l3o, l3l] = request.security(syminfo.tickerid, tf3, detectLive(), lookahead = barmerge.lookahead_off)
[c4b, c4r, c4t, c4o, c4l] = request.security(syminfo.tickerid, tf4, detectClosed(), lookahead = barmerge.lookahead_on)
[l4b, l4r, l4t, l4o, l4l] = request.security(syminfo.tickerid, tf4, detectLive(), lookahead = barmerge.lookahead_off)
[c5b, c5r, c5t, c5o, c5l] = request.security(syminfo.tickerid, tf5, detectClosed(), lookahead = barmerge.lookahead_on)
[l5b, l5r, l5t, l5o, l5l] = request.security(syminfo.tickerid, tf5, detectLive(), lookahead = barmerge.lookahead_off)

// ========================================
// QUALIFICATION HELPERS (NEW)
// ========================================
// Zones drawn by "Qualifying Only" mode. Held separately from the FVG tracking
// array because the gap that produced them may already have been filled and
// dropped — the drawing outlives the gap, staying attached to the setup instead.
var array<box>   qualBoxes  = array.new<box>()
var array<label> qualLabels = array.new<label>()

// Draws the one gap whose tap qualified a Unicorn, stretched from where the gap
// formed to the bar the setup confirmed on, so the cause and the setup read as a
// single object. Styled with the FVG engine's own colour and label inputs.
// Trimmed to the Unicorn's own History setting so zones age out with setups.
f_drawQualifyingFvg(bool bull, float top, float bot, int leftTime, int rightTime, string tfLabel) =>
    if not na(top) and not na(bot) and not na(leftTime)
        box bx = box.new(leftTime, top, rightTime, bot, xloc = xloc.bar_time,
                 bgcolor      = bull ? bullBoxColor : bearBoxColor,
                 border_color = bull ? bullBorderColor : bearBorderColor,
                 border_width = borderWidth,
                 border_style = borderStyleOf())
        label lb = label.new(labelX(leftTime, rightTime), math.avg(top, bot), tfLabel, xloc = xloc.bar_time,
                 style     = label.style_none,
                 textcolor = bull ? bullLabelColor : bearLabelColor,
                 size      = labelSizeOf())
        array.push(qualBoxes, bx)
        array.push(qualLabels, lb)
        while array.size(qualBoxes) > historyCount
            box   oldBx = array.shift(qualBoxes)
            label oldLb = array.shift(qualLabels)
            box.delete(oldBx)
            label.delete(oldLb)

// Removes the setup that was just pushed, together with every drawing attached
// to it — the same cleanup the Unicorn's own history-limit and
// discard-invalidated paths perform. Called only from the qualification hooks,
// immediately after array.push, so the target is always the last element.
//
// This hides output; it does not change the engine. The setup was still
// confirmed by the Unicorn Model on exactly the same bar under exactly the same
// conditions, and the pending sweep leg is still consumed by it.
f_discardLastSetup() =>
    if array.size(activeSetups) > 0
        Setup s = array.pop(activeSetups)
        line.delete(s.levelLine)
        label.delete(s.levelLabel)
        box.delete(s.breakerBox)
        if not na(s.fvgBox)
            box.delete(s.fvgBox)
        label.delete(s.setupLabel)
        for l in s.targetLines
            line.delete(l)
        for lb in s.targetLabels
            label.delete(lb)

// Diagnostics label. Anchored to the bar it describes, off the candle so it does
// not sit on top of the Unicorn's own markers.
f_dbg(bool bull, string txt) =>
    if debugMode and bar_index > last_bar_index - debugBars
        label.new(
             x = bar_index,
             y = bull ? low : high,
             text = txt,
             style = bull ? label.style_label_up : label.style_label_down,
             color = color.new(color.orange, 75),
             textcolor = labelTextColor,
             size = size.tiny,
             text_font_family = font.family_monospace
             )

// ========================================
// HTF FVG INTERACTION STATE (NEW)
// ========================================
// bar_index of the most recent tap of a HTF FVG in each direction, plus the
// timeframe label of the gap that produced it.
//
// These are written in exactly one place — the FVG maintenance loop below — and
// that loop can only ever record the *current* bar. That is what makes the
// required "tap happened before the Unicorn" ordering structural rather than
// something that has to be re-checked: a tap on a later bar cannot reach back
// and qualify an earlier Unicorn, because the earlier Unicorn's marker was
// already evaluated and committed on its own bar.
var int    lastBullTapBar = na
var int    lastBearTapBar = na
var string lastBullTapTf  = ""
var string lastBearTapTf  = ""

// Geometry of the tapped gap, captured at tap time. Stored rather than looked
// up later because the gap may well have been filled and dropped from the
// tracking array by the time a Unicorn confirms.
var float  lastBullTapTop  = na
var float  lastBullTapBot  = na
var int    lastBullTapLeft = na
var float  lastBearTapTop  = na
var float  lastBearTapBot  = na
var int    lastBearTapLeft = na

// The most recently qualified Unicorn, recorded at its confirmation bar. Keeping
// this here rather than adding fields to the Setup type leaves the Unicorn
// engine untouched; a setup is matched to it by confirmation bar + direction,
// which is exact because a setup's confIndex is the bar it was pushed on.
var int    lastQualBar = na
var string lastQualDir = ""
var string lastQualTf  = ""

// ─── HTF FVG layer: build gaps, then track taps and fills ────────────────────
// Wrapped in enableHtfFvg so the whole layer produces nothing — no boxes, no
// labels, no state, no alerts — when the context filter is off.
if enableHtfFvg
    processSlot(0, e1, tf1, n1, c1b, c1r, c1t, c1o, c1l, l1b, l1r, l1t, l1o, l1l)
    processSlot(1, e2, tf2, n2, c2b, c2r, c2t, c2o, c2l, l2b, l2r, l2t, l2o, l2l)
    processSlot(2, e3, tf3, n3, c3b, c3r, c3t, c3o, c3l, l3b, l3r, l3t, l3o, l3l)
    processSlot(3, e4, tf4, n4, c4b, c4r, c4t, c4o, c4l, l4b, l4r, l4t, l4o, l4l)
    processSlot(4, e5, tf5, n5, c5b, c5r, c5t, c5o, c5l, l5b, l5r, l5t, l5o, l5l)

// ─── Maintenance: extend, entry alerts, fill ─────────────────────────────────
bool bullEnter = false
bool bearEnter = false

if enableHtfFvg and array.size(fvgs) > 0
    for i = array.size(fvgs) - 1 to 0
        Fvg f = array.get(fvgs, i)

        bool filled = f.bull ? (fillType == "Close" ? close <= f.bot : low  <= f.bot)
                             : (fillType == "Close" ? close >= f.top : high >= f.top)

        // Price trading anywhere inside the gap, fired once per gap.
        if not f.entered and low <= f.top and high >= f.bot
            f.entered := true
            if f.bull
                bullEnter := true
                // Multiple active FVGs: the loop runs newest → oldest, so the
                // first tap seen on a bar belongs to the newest gap, and that is
                // the timeframe reported. The qualifying state itself is one
                // slot per direction — qualification is a property of the
                // Unicorn, not of a gap, so a Unicorn can never qualify twice
                // no matter how many gaps were tapped.
                if nz(lastBullTapBar, -1) != bar_index
                    lastBullTapTf   := f.tfLabel
                    lastBullTapTop  := f.top
                    lastBullTapBot  := f.bot
                    lastBullTapLeft := f.leftTime
                lastBullTapBar := bar_index
            else
                bearEnter := true
                if nz(lastBearTapBar, -1) != bar_index
                    lastBearTapTf   := f.tfLabel
                    lastBearTapTop  := f.top
                    lastBearTapBot  := f.bot
                    lastBearTapLeft := f.leftTime
                lastBearTapBar := bar_index
            if alertFvgTap
                alert(syminfo.ticker + ": price entered " + (f.bull ? "bullish" : "bearish") + " FVG (" + f.tfLabel + ") " +
                      str.tostring(f.bot, format.mintick) + " - " + str.tostring(f.top, format.mintick), alert.freq_once_per_bar)

        if extendBoxes and not na(f.bx)
            box.set_right(f.bx, time)
            label.set_x(f.lb, labelX(box.get_left(f.bx), time))

        if filled
            if deleteAfterFill and not na(f.bx)
                box.delete(f.bx)
                label.delete(f.lb)
            // Filled gaps stop being tracked either way: no more extending, no more alerts.
            array.remove(fvgs, i)

// ========================================
// HTF FVG CONTEXT FILTER (NEW)
// ========================================
// A direction is "in context" while its most recent tap is still inside the
// configured window. Both are plain reads of state written above — the Unicorn
// engine below consumes them and never writes to them.
bool bullHtfContext = enableHtfFvg and qualifyBull and not na(lastBullTapBar) and (bar_index - lastBullTapBar) <= htfFvgWindow
bool bearHtfContext = enableHtfFvg and qualifyBear and not na(lastBearTapBar) and (bar_index - lastBearTapBar) <= htfFvgWindow

// Whether a confirmed setup that failed qualification should be hidden. Gated on
// enableHtfFvg as well as the display switch: with the context layer off nothing
// can ever qualify, so an ungated check would delete every setup the Unicorn
// Model produces and blank the chart.
bool hideUnqualified = enableHtfFvg and onlyQualifiedSetups

// Set by the qualification hooks inside the Unicorn confirmation blocks below.
bool qualifiedBullSignal = false
bool qualifiedBearSignal = false

// Track formation bar index for each liquidity level
var float lastPrevH_A = na
var float lastSh_A = na
var float lastPrevL_A = na
var float lastSl_A = na

var float lastPrevH_B = na
var float lastSh_B = na
var float lastPrevL_B = na
var float lastSl_B = na

var float lastPrevH_C = na
var float lastSh_C = na
var float lastPrevL_C = na
var float lastSl_C = na

var float lastPrevH_D = na
var float lastSh_D = na
var float lastPrevL_D = na
var float lastSl_D = na

// Register newly formed levels on change (Fixed: added na check guard for correct initial historical load)
// Source A
if useA_resolved
    if (typeA == "OHLC" or typeA == "OHLC + Swing")
        if prevH_A != lastPrevH_A or (na(lastPrevH_A) and not na(prevH_A))
            lastPrevH_A := prevH_A
            f_registerLevel(f_getTFLabel(htfA_resolved), "OHLC", true, prevH_A)
        if prevL_A != lastPrevL_A or (na(lastPrevL_A) and not na(prevL_A))
            lastPrevL_A := prevL_A
            f_registerLevel(f_getTFLabel(htfA_resolved), "OHLC", false, prevL_A)
    if (typeA == "Swing" or typeA == "OHLC + Swing")
        if sh_A != lastSh_A or (na(lastSh_A) and not na(sh_A))
            lastSh_A := sh_A
            f_registerLevel(f_getTFLabel(htfA_resolved), "Swing", true, sh_A)
        if sl_A != lastSl_A or (na(lastSl_A) and not na(sl_A))
            lastSl_A := sl_A
            f_registerLevel(f_getTFLabel(htfA_resolved), "Swing", false, sl_A)

// Source B
if useB_resolved
    if (typeB == "OHLC" or typeB == "OHLC + Swing")
        if prevH_B != lastPrevH_B or (na(lastPrevH_B) and not na(prevH_B))
            lastPrevH_B := prevH_B
            f_registerLevel(f_getTFLabel(htfB_resolved), "OHLC", true, prevH_B)
        if prevL_B != lastPrevL_B or (na(lastPrevL_B) and not na(prevL_B))
            lastPrevL_B := prevL_B
            f_registerLevel(f_getTFLabel(htfB_resolved), "OHLC", false, prevL_B)
    if (typeB == "Swing" or typeB == "OHLC + Swing")
        if sh_B != lastSh_B or (na(lastSh_B) and not na(sh_B))
            lastSh_B := sh_B
            f_registerLevel(f_getTFLabel(htfB_resolved), "Swing", true, sh_B)
        if sl_B != lastSl_B or (na(lastSl_B) and not na(sl_B))
            lastSl_B := sl_B
            f_registerLevel(f_getTFLabel(htfB_resolved), "Swing", false, sl_B)

// Source C
if useC_resolved
    if (typeC == "OHLC" or typeC == "OHLC + Swing")
        if prevH_C != lastPrevH_C or (na(lastPrevH_C) and not na(prevH_C))
            lastPrevH_C := prevH_C
            f_registerLevel(f_getTFLabel(htfC_resolved), "OHLC", true, prevH_C)
        if prevL_C != lastPrevL_C or (na(lastPrevL_C) and not na(prevL_C))
            lastPrevL_C := prevL_C
            f_registerLevel(f_getTFLabel(htfC_resolved), "OHLC", false, prevL_C)
    if (typeC == "Swing" or typeC == "OHLC + Swing")
        if sh_C != lastSh_C or (na(lastSh_C) and not na(sh_C))
            lastSh_C := sh_C
            f_registerLevel(f_getTFLabel(htfC_resolved), "Swing", true, sh_C)
        if sl_C != lastSl_C or (na(lastSl_C) and not na(sl_C))
            lastSl_C := sl_C
            f_registerLevel(f_getTFLabel(htfC_resolved), "Swing", false, sl_C)

// Source D
if useD_resolved
    if (typeD == "OHLC" or typeD == "OHLC + Swing")
        if prevH_D != lastPrevH_D or (na(lastPrevH_D) and not na(prevH_D))
            lastPrevH_D := prevH_D
            f_registerLevel(f_getTFLabel(htfD_resolved), "OHLC", true, prevH_D)
        if prevL_D != lastPrevL_D or (na(lastPrevL_D) and not na(prevL_D))
            lastPrevL_D := prevL_D
            f_registerLevel(f_getTFLabel(htfD_resolved), "OHLC", false, prevL_D)
    if (typeD == "Swing" or typeD == "OHLC + Swing")
        if sh_D != lastSh_D or (na(lastSh_D) and not na(sh_D))
            lastSh_D := sh_D
            f_registerLevel(f_getTFLabel(htfD_resolved), "Swing", true, sh_D)
        if sl_D != lastSl_D or (na(lastSl_D) and not na(sl_D))
            lastSl_D := sl_D
            f_registerLevel(f_getTFLabel(htfD_resolved), "Swing", false, sl_D)

// ========================================
// MAIN EXECUTION STATE MACHINE (Level update & sweep check)
// ========================================
bool sweptBull = false
float sweptBullPrice = na
int sweptBullStartBar = na
string sweptBulllabelText = ""

bool sweptBear = false
float sweptBearPrice = na
int sweptBearStartBar = na
string sweptBearlabelText = ""

if array.size(activeHTFLevels) > 0
    for idx = array.size(activeHTFLevels) - 1 to 0
        lvl = array.get(activeHTFLevels, idx)

        bool swept = false
        if lvl.isHigh
            if high >= lvl.price
                swept := true
                sweptBull := true
                if na(sweptBullPrice) or lvl.price > sweptBullPrice
                    sweptBullPrice := lvl.price
                    sweptBullStartBar := lvl.startBar
                    sweptBulllabelText := lvl.labelText
                else if lvl.price == sweptBullPrice
                    if not str.contains(sweptBulllabelText, lvl.labelText)
                        sweptBulllabelText := sweptBulllabelText + ", " + lvl.labelText
        else
            if low <= lvl.price
                swept := true
                sweptBear := true
                if na(sweptBearPrice) or lvl.price < sweptBearPrice
                    sweptBearPrice := lvl.price
                    sweptBearStartBar := lvl.startBar
                    sweptBearlabelText := lvl.labelText
                else if lvl.price == sweptBearPrice
                    if not str.contains(sweptBearlabelText, lvl.labelText)
                        sweptBearlabelText := sweptBearlabelText + ", " + lvl.labelText

        if swept
            lvl.isSwept := true
            lvl.sweepBar := bar_index
            // Performance Optimization: Immediately remove swept level from execution array
            array.remove(activeHTFLevels, idx)

// Limit level memory history to prevent array overflow
while array.size(activeHTFLevels) > 100
    array.shift(activeHTFLevels)

// 2. Process & Track Sweeps (Corrected: updates on new sweep event OR extreme extension)
if sweptBear and (biasSelect == "Neutral" or biasSelect == "Bullish")
    pendingBullSweepIdx := bar_index
    pendingBullFirstSweepBar := bar_index
    pendingBullSweepExtreme := low
    pendingBullSweptLevel := sweptBearPrice
    pendingBullSweptStartBar := sweptBearStartBar
    pendingBullSweptLabelText := sweptBearlabelText
else if not na(pendingBullSweepIdx) and low < pendingBullSweepExtreme
    pendingBullSweepExtreme := low
    pendingBullSweepIdx := bar_index

if sweptBull and (biasSelect == "Neutral" or biasSelect == "Bearish")
    pendingBearSweepIdx := bar_index
    pendingBearFirstSweepBar := bar_index
    pendingBearSweepExtreme := high
    pendingBearSweptLevel := sweptBullPrice
    pendingBearSweptStartBar := sweptBullStartBar
    pendingBearSweptLabelText := sweptBulllabelText
else if not na(pendingBearSweepIdx) and high > pendingBearSweepExtreme
    pendingBearSweepExtreme := high
    pendingBearSweepIdx := bar_index

// 3. Track & Confirm Pending Setups

// Track Bullish setups
if not na(pendingBullSweepIdx)
    sweepOffset = bar_index - pendingBullSweepIdx
    [startOffset, endOffset] = f_findUpCandlesSeries(sweepOffset)

    if not na(startOffset)
        [breakerT, breakerB] = f_getSeriesRange(startOffset, endOffset)

        // Validation: Breaker bottom must not be below (more extreme than) the sweep low extreme
        // Hoisted into named bools purely so the diagnostics can name the gate
        // that rejected the bar. The conjunction below is the original condition.
        bool gateBreakBull = close > breakerT
        bool gateSweepBull = breakerB >= pendingBullSweepExtreme
        bool gateSessBull  = f_isInSession()

        if gateBreakBull and gateSweepBull and gateSessBull
            if f_checkSizeFilter(breakerT, breakerB, sizeFilterMode, minBreakerSize, maxBreakerSize, breakerSizeUnit)
                breakerStartBar = bar_index - endOffset
                [fvgT, fvgB, fvgIdx, fvgRightIdx] = f_findBullishFVG(breakerT, breakerB, breakerStartBar, enableFvgAtrFilter, fvgAtrMult)
                hasFvg = not na(fvgIdx)

                if not unicornMode or (unicornMode and hasFvg)
                    float invPrice = useSwingInvalidation ? pendingBullSweepExtreme : breakerB
                    float riskRange = close - invPrice

                    if riskRange > 0
                        Setup newBull = Setup.new(
                             dir = "BULL",
                             sweepIndex = pendingBullFirstSweepBar,
                             sweepExtreme = pendingBullSweepExtreme,
                             sweptLevel = pendingBullSweptLevel,
                             sweptLevelStartBar = pendingBullSweptStartBar,
                             breakerStartIdx = bar_index - startOffset,
                             breakerEndIdx = bar_index - endOffset,
                             breakerTop = breakerT,
                             breakerBottom = breakerB,
                             isConfirmed = true,
                             confIndex = bar_index,
                             entryPrice = close,
                             invalidationPrice = invPrice,
                             isInvalidated = false,
                             isTargetHit = false,
                             levelLine = na,
                             levelLabel = na,
                             breakerBox = na,
                             fvgBox = na,
                             targetLines = array.new_line(),
                             targetLabels = array.new_label(),
                             setupLabel = na
                             )

                        // Setup-linked level line (starts at exact extreme index, ends at sweepIndex)
                        int lineStartB = math.max(newBull.sweptLevelStartBar, bar_index - 4500)
                        newBull.levelLine := line.new(
                             x1 = lineStartB,
                             y1 = newBull.sweptLevel,
                             x2 = newBull.sweepIndex,
                             y2 = newBull.sweptLevel,
                             color = sweepLineColor,
                             style = f_getLineStyle(sweepLineStyle),
                             width = sweepLineWidth
                             )

                        newBull.levelLabel := label.new(
                             x = lineStartB,
                             y = newBull.sweptLevel + (nz(ta.atr(14)) * 0.1),
                             text = pendingBullSweptLabelText,
                             color = color.new(na, na),
                             textcolor = labelTextColor,
                             style = label.style_label_left,
                             size = f_getLabelSize(labelSizeStr),
                             text_font_family = font.family_monospace
                             )

                        newBull.breakerBox := box.new(
                             left = bar_index - endOffset,
                             top = newBull.breakerTop,
                             right = bar_index,
                             bottom = newBull.breakerBottom,
                             border_color = bullColorBorder,
                             bgcolor = bullColorActive,
                             xloc = xloc.bar_index
                             )

                        if hasFvg
                            newBull.fvgBox := box.new(
                                 left = fvgIdx,
                                 top = fvgT,
                                 right = fvgRightIdx,
                                 bottom = fvgB,
                                 border_color = color.new(na, na),
                                 bgcolor = bullFvgColor,
                                 xloc = xloc.bar_index
                                 )

                        labelText = hasFvg ? "+Unicorn" : "+Breaker"
                        tooltipText = "Setup: " + (hasFvg ? "Bullish Unicorn" : "Bullish Breaker") + "\n" +
                                     "Swept Level: " + str.tostring(newBull.sweptLevel, format.mintick) + "\n" +
                                     "Entry: " + str.tostring(newBull.entryPrice, format.mintick) + "\n" +
                                     "Stop Loss: " + str.tostring(newBull.invalidationPrice, format.mintick)

                        newBull.setupLabel := label.new(
                             x = bar_index,
                             y = (newBull.breakerTop + newBull.breakerBottom) / 2.0,
                             text = labelText,
                             color = color.new(na, na),
                             textcolor = labelTextColor,
                             style = label.style_label_right,
                             size = f_getLabelSize(labelSizeStr),
                             tooltip = tooltipText,
                             text_font_family = font.family_monospace
                             )

                        primaryTargetPrice = close + rrRatio * riskRange
                        if showRRTarget
                            l = line.new(
                                 x1 = newBull.breakerEndIdx,
                                 y1 = primaryTargetPrice,
                                 x2 = newBull.confIndex,
                                 y2 = primaryTargetPrice,
                                 color = labelTextColor,
                                 style = f_getLineStyle(projLineStyle),
                                 width = projLineWidth
                                 )
                            lbl = label.new(
                                 x = newBull.confIndex,
                                 y = primaryTargetPrice,
                                 text = str.tostring(rrRatio, "#.##") + "R",
                                 color = color.new(na, na),
                                 textcolor = labelTextColor,
                                 style = label.style_label_left,
                                 size = f_getLabelSize(labelSizeStr),
                                 tooltip = "Target level: " + str.tostring(primaryTargetPrice, format.mintick),
                                 text_font_family = font.family_monospace
                                 )
                            array.push(newBull.targetLines, l)
                            array.push(newBull.targetLabels, lbl)

                        if showAddTargets
                            tgts = f_parseTargets(addTargetsStr)
                            if array.size(tgts) > 0
                                for i = 0 to array.size(tgts) - 1
                                    m = array.get(tgts, i)
                                    tgtVal = close + m * riskRange
                                    l = line.new(
                                         x1 = newBull.breakerEndIdx,
                                         y1 = tgtVal,
                                         x2 = newBull.confIndex,
                                         y2 = tgtVal,
                                         color = labelTextColor,
                                         style = f_getLineStyle(projLineStyle),
                                         width = projLineWidth
                                         )
                                    lbl = label.new(
                                         x = newBull.confIndex,
                                         y = tgtVal,
                                         text = str.tostring(m, "#.##") + "R",
                                         color = color.new(na, na),
                                         textcolor = labelTextColor,
                                         style = label.style_label_left,
                                         size = f_getLabelSize(labelSizeStr),
                                         tooltip = "Target level: " + str.tostring(tgtVal, format.mintick),
                                         text_font_family = font.family_monospace
                                         )
                                    array.push(newBull.targetLines, l)
                                    array.push(newBull.targetLabels, lbl)

                        array.push(activeSetups, newBull)

                        if enableAlerts and alertActivation
                            alert("Activation: Bullish Breaker activated on " + syminfo.ticker + " at " + str.tostring(close), alert.freq_once_per_bar_close)

                        // ── HTF FVG qualification (NEW) ──────────────────────
                        // Runs after the setup has already been built and
                        // pushed, so it never influences whether the Unicorn
                        // Model confirmed — it only decides how the result is
                        // presented: marked, or (in Only Qualified mode) hidden.
                        // hasFvg is required, so only a true "+Unicorn" can be
                        // qualified — a "+Breaker" never is.
                        if bullHtfContext and hasFvg
                            qualifiedBullSignal := true
                            lastQualBar := bar_index
                            lastQualDir := "BULL"
                            lastQualTf  := lastBullTapTf
                            if fvgZoneMode == "Qualifying Only"
                                f_drawQualifyingFvg(true, lastBullTapTop, lastBullTapBot, lastBullTapLeft, time, lastBullTapTf)
                            if enableAlerts
                                alert("Qualified Bullish Unicorn on " + syminfo.ticker + " at " + str.tostring(close) + " — " + lastBullTapTf + " HTF FVG tapped " + str.tostring(bar_index - lastBullTapBar) + " bar(s) ago", alert.freq_once_per_bar_close)
                        else if hideUnqualified
                            // No same-direction bullish HTF FVG tap behind this
                            // setup: hide it rather than mark it.
                            f_discardLastSetup()

                        pendingBullSweepIdx := na
                        pendingBullFirstSweepBar := na
                    else if debugMode
                        f_dbg(true, "BULL rejected: risk<=0\nclose=" + str.tostring(close, format.mintick) + " inval=" + str.tostring(invPrice, format.mintick))
                else if debugMode
                    f_dbg(true, "BULL rejected: no FVG\nUnicorn Mode is ON and no unmitigated bullish FVG overlaps the breaker on this bar.\nbreaker=" + str.tostring(breakerB, format.mintick) + "-" + str.tostring(breakerT, format.mintick) + "\nscanned " + str.tostring(math.min(endOffset, 100)) + " bars back")
            else if debugMode
                f_dbg(true, "BULL rejected: size filter\nsize=" + str.tostring(breakerT - breakerB, format.mintick) + " pts (" + str.tostring(minBreakerSize) + "-" + str.tostring(maxBreakerSize) + " " + breakerSizeUnit + ")")
        else if debugMode and (gateBreakBull or debugNoSweep)
            f_dbg(true, "BULL rejected: gate\nclose>breakerTop=" + (gateBreakBull ? "Y" : "N") + " (close=" + str.tostring(close, format.mintick) + " top=" + str.tostring(breakerT, format.mintick) + ")\nbreakerBot>=sweepLow=" + (gateSweepBull ? "Y" : "N") + " (bot=" + str.tostring(breakerB, format.mintick) + " low=" + str.tostring(pendingBullSweepExtreme, format.mintick) + ")\ninSession=" + (gateSessBull ? "Y" : "N"))
    else if debugMode and debugNoSweep
        f_dbg(true, "BULL rejected: no breaker\nNo run of 2+ consecutive up candles found within 40 bars back from the sweep bar.")
else if debugMode and debugNoSweep
    f_dbg(true, "BULL: no pending sweep leg")

// Track Bearish setups
if not na(pendingBearSweepIdx)
    sweepOffset = bar_index - pendingBearSweepIdx
    [startOffset, endOffset] = f_findDownCandlesSeries(sweepOffset)

    if not na(startOffset)
        [breakerT, breakerB] = f_getSeriesRange(startOffset, endOffset)

        // Validation: Breaker top must not be above (more extreme than) the sweep high extreme
        // Hoisted into named bools purely so the diagnostics can name the gate
        // that rejected the bar. The conjunction below is the original condition.
        bool gateBreakBear = close < breakerB
        bool gateSweepBear = breakerT <= pendingBearSweepExtreme
        bool gateSessBear  = f_isInSession()

        if gateBreakBear and gateSweepBear and gateSessBear
            if f_checkSizeFilter(breakerT, breakerB, sizeFilterMode, minBreakerSize, maxBreakerSize, breakerSizeUnit)
                breakerStartBar = bar_index - endOffset
                [fvgT, fvgB, fvgIdx, fvgRightIdx] = f_findBearishFVG(breakerT, breakerB, breakerStartBar, enableFvgAtrFilter, fvgAtrMult)
                hasFvg = not na(fvgIdx)

                if not unicornMode or (unicornMode and hasFvg)
                    float invPrice = useSwingInvalidation ? pendingBearSweepExtreme : breakerT
                    float riskRange = invPrice - close

                    if riskRange > 0
                        Setup newBear = Setup.new(
                             dir = "BEAR",
                             sweepIndex = pendingBearFirstSweepBar,
                             sweepExtreme = pendingBearSweepExtreme,
                             sweptLevel = pendingBearSweptLevel,
                             sweptLevelStartBar = pendingBearSweptStartBar,
                             breakerStartIdx = bar_index - startOffset,
                             breakerEndIdx = bar_index - endOffset,
                             breakerTop = breakerT,
                             breakerBottom = breakerB,
                             isConfirmed = true,
                             confIndex = bar_index,
                             entryPrice = close,
                             invalidationPrice = invPrice,
                             isInvalidated = false,
                             isTargetHit = false,
                             levelLine = na,
                             levelLabel = na,
                             breakerBox = na,
                             fvgBox = na,
                             targetLines = array.new_line(),
                             targetLabels = array.new_label(),
                             setupLabel = na
                             )

                        // Setup-linked level line (starts at exact extreme index, ends at sweepIndex)
                        int lineStartB = math.max(newBear.sweptLevelStartBar, bar_index - 4500)
                        newBear.levelLine := line.new(
                             x1 = lineStartB,
                             y1 = newBear.sweptLevel,
                             x2 = newBear.sweepIndex,
                             y2 = newBear.sweptLevel,
                             color = sweepLineColor,
                             style = f_getLineStyle(sweepLineStyle),
                             width = sweepLineWidth
                             )

                        newBear.levelLabel := label.new(
                             x = lineStartB,
                             y = newBear.sweptLevel + (nz(ta.atr(14)) * 0.1),
                             text = pendingBearSweptLabelText,
                             color = color.new(na, na),
                             textcolor = labelTextColor,
                             style = label.style_label_left,
                             size = f_getLabelSize(labelSizeStr),
                             text_font_family = font.family_monospace
                             )

                        newBear.breakerBox := box.new(
                             left = bar_index - endOffset,
                             top = newBear.breakerTop,
                             right = bar_index,
                             bottom = newBear.breakerBottom,
                             border_color = bearColorBorder,
                             bgcolor = bearColorActive,
                             xloc = xloc.bar_index
                             )

                        if hasFvg
                            newBear.fvgBox := box.new(
                                 left = fvgIdx,
                                 top = fvgT,
                                 right = fvgRightIdx,
                                 bottom = fvgB,
                                 border_color = color.new(na, na),
                                 bgcolor = bearFvgColor,
                                 xloc = xloc.bar_index
                                 )

                        labelText = hasFvg ? "-Unicorn" : "-Breaker"
                        tooltipText = "Setup: " + (hasFvg ? "Bearish Unicorn" : "Bearish Breaker") + "\n" +
                                     "Swept Level: " + str.tostring(newBear.sweptLevel, format.mintick) + "\n" +
                                     "Entry: " + str.tostring(newBear.entryPrice, format.mintick) + "\n" +
                                     "Stop Loss: " + str.tostring(newBear.invalidationPrice, format.mintick)

                        newBear.setupLabel := label.new(
                             x = bar_index,
                             y = (newBear.breakerTop + newBear.breakerBottom) / 2.0,
                             text = labelText,
                             color = color.new(na, na),
                             textcolor = labelTextColor,
                             style = label.style_label_right,
                             size = f_getLabelSize(labelSizeStr),
                             tooltip = tooltipText,
                             text_font_family = font.family_monospace
                             )

                        primaryTargetPrice = close - rrRatio * riskRange
                        if showRRTarget
                            l = line.new(
                                 x1 = newBear.breakerEndIdx,
                                 y1 = primaryTargetPrice,
                                 x2 = newBear.confIndex,
                                 y2 = primaryTargetPrice,
                                 color = labelTextColor,
                                 style = f_getLineStyle(projLineStyle),
                                 width = projLineWidth
                                 )
                            lbl = label.new(
                                 x = newBear.confIndex,
                                 y = primaryTargetPrice,
                                 text = str.tostring(rrRatio, "#.##") + "R",
                                 color = color.new(na, na),
                                 textcolor = labelTextColor,
                                 style = label.style_label_left,
                                 size = f_getLabelSize(labelSizeStr),
                                 tooltip = "Target level: " + str.tostring(primaryTargetPrice, format.mintick),
                                 text_font_family = font.family_monospace
                                 )
                            array.push(newBear.targetLines, l)
                            array.push(newBear.targetLabels, lbl)

                        if showAddTargets
                            tgts = f_parseTargets(addTargetsStr)
                            if array.size(tgts) > 0
                                for i = 0 to array.size(tgts) - 1
                                    m = array.get(tgts, i)
                                    tgtVal = close - m * riskRange
                                    l = line.new(
                                         x1 = newBear.breakerEndIdx,
                                         y1 = tgtVal,
                                         x2 = newBear.confIndex,
                                         y2 = tgtVal,
                                         color = labelTextColor,
                                         style = f_getLineStyle(projLineStyle),
                                         width = projLineWidth
                                         )
                                    lbl = label.new(
                                         x = newBear.confIndex,
                                         y = tgtVal,
                                         text = str.tostring(m, "#.##") + "R",
                                         color = color.new(na, na),
                                         textcolor = labelTextColor,
                                         style = label.style_label_left,
                                         size = f_getLabelSize(labelSizeStr),
                                         tooltip = "Target level: " + str.tostring(tgtVal, format.mintick),
                                         text_font_family = font.family_monospace
                                         )
                                    array.push(newBear.targetLines, l)
                                    array.push(newBear.targetLabels, lbl)

                        array.push(activeSetups, newBear)

                        if enableAlerts and alertActivation
                            alert("Activation: Bearish Breaker activated on " + syminfo.ticker + " at " + str.tostring(close), alert.freq_once_per_bar_close)

                        // ── HTF FVG qualification (NEW) ──────────────────────
                        // Runs after the setup has already been built and
                        // pushed, so it never influences whether the Unicorn
                        // Model confirmed — it only decides how the result is
                        // presented: marked, or (in Only Qualified mode) hidden.
                        // hasFvg is required, so only a true "-Unicorn" can be
                        // qualified — a "-Breaker" never is.
                        if bearHtfContext and hasFvg
                            qualifiedBearSignal := true
                            lastQualBar := bar_index
                            lastQualDir := "BEAR"
                            lastQualTf  := lastBearTapTf
                            if fvgZoneMode == "Qualifying Only"
                                f_drawQualifyingFvg(false, lastBearTapTop, lastBearTapBot, lastBearTapLeft, time, lastBearTapTf)
                            if enableAlerts
                                alert("Qualified Bearish Unicorn on " + syminfo.ticker + " at " + str.tostring(close) + " — " + lastBearTapTf + " HTF FVG tapped " + str.tostring(bar_index - lastBearTapBar) + " bar(s) ago", alert.freq_once_per_bar_close)
                        else if hideUnqualified
                            // No same-direction bearish HTF FVG tap behind this
                            // setup: hide it rather than mark it.
                            f_discardLastSetup()

                        pendingBearSweepIdx := na
                        pendingBearFirstSweepBar := na
                    else if debugMode
                        f_dbg(false, "BEAR rejected: risk<=0\nclose=" + str.tostring(close, format.mintick) + " inval=" + str.tostring(invPrice, format.mintick))
                else if debugMode
                    f_dbg(false, "BEAR rejected: no FVG\nUnicorn Mode is ON and no unmitigated bearish FVG overlaps the breaker on this bar.\nbreaker=" + str.tostring(breakerB, format.mintick) + "-" + str.tostring(breakerT, format.mintick) + "\nscanned " + str.tostring(math.min(endOffset, 100)) + " bars back")
            else if debugMode
                f_dbg(false, "BEAR rejected: size filter\nsize=" + str.tostring(breakerT - breakerB, format.mintick) + " pts (" + str.tostring(minBreakerSize) + "-" + str.tostring(maxBreakerSize) + " " + breakerSizeUnit + ")")
        else if debugMode and (gateBreakBear or debugNoSweep)
            f_dbg(false, "BEAR rejected: gate\nclose<breakerBot=" + (gateBreakBear ? "Y" : "N") + " (close=" + str.tostring(close, format.mintick) + " bot=" + str.tostring(breakerB, format.mintick) + ")\nbreakerTop<=sweepHigh=" + (gateSweepBear ? "Y" : "N") + " (top=" + str.tostring(breakerT, format.mintick) + " high=" + str.tostring(pendingBearSweepExtreme, format.mintick) + ")\ninSession=" + (gateSessBear ? "Y" : "N"))
    else if debugMode and debugNoSweep
        f_dbg(false, "BEAR rejected: no breaker\nNo run of 2+ consecutive down candles found within 40 bars back from the sweep bar.")
else if debugMode and debugNoSweep
    f_dbg(false, "BEAR: no pending sweep leg")

// 4. Update Existing Active Setups
if array.size(activeSetups) > 0
    for idx = array.size(activeSetups) - 1 to 0
        setup = array.get(activeSetups, idx)

        if not setup.isInvalidated
            // Invalidation checks
            bool invHit = false
            if setup.dir == "BULL"
                if low < setup.invalidationPrice
                    invHit := true
            else
                if high > setup.invalidationPrice
                    invHit := true

            if invHit
                setup.isInvalidated := true
                if enableAlerts and alertInvalidation
                    alert("Invalidation Hit: Setup " + setup.dir + " invalidated on " + syminfo.ticker, alert.freq_once_per_bar_close)

                if discardInvalidated
                    line.delete(setup.levelLine)
                    label.delete(setup.levelLabel)
                    box.delete(setup.breakerBox)
                    if not na(setup.fvgBox)
                        box.delete(setup.fvgBox)
                    label.delete(setup.setupLabel)
                    for l in setup.targetLines
                        line.delete(l)
                    for lb in setup.targetLabels
                        label.delete(lb)
                    array.remove(activeSetups, idx)
                    continue
                else
                    box.set_border_color(setup.breakerBox, setup.dir == "BULL" ? bullColorInactive : bearColorInactive)
                    box.set_bgcolor(setup.breakerBox, setup.dir == "BULL" ? bullColorInactive : bearColorInactive)
                    if not na(setup.fvgBox)
                        box.set_bgcolor(setup.fvgBox, setup.dir == "BULL" ? bullColorInactive : bearColorInactive)
                    label.set_textcolor(setup.setupLabel, setup.dir == "BULL" ? bullColorInactive : bearColorInactive)

                    for l in setup.targetLines
                        line.delete(l)
                    for lb in setup.targetLabels
                        label.delete(lb)
                    array.clear(setup.targetLines)
                    array.clear(setup.targetLabels)
            else
                // Extend breaker box only (FVG and targets are static)
                box.set_right(setup.breakerBox, bar_index)
                label.set_x(setup.setupLabel, bar_index)

                // Track targets hit
                int activeTargets = 0
                if array.size(setup.targetLines) > 0
                    for i = array.size(setup.targetLines) - 1 to 0
                        l = array.get(setup.targetLines, i)
                        lb = array.get(setup.targetLabels, i)
                        tgtVal = line.get_y1(l)

                        bool hit = false
                        if setup.dir == "BULL"
                            if high >= tgtVal
                                hit := true
                        else
                            if low <= tgtVal
                                hit := true

                        if hit
                            if enableAlerts and alertTarget
                                alert("Target Reached: Setup " + setup.dir + " target reached at " + str.tostring(tgtVal), alert.freq_once_per_bar_close)
                            line.delete(l)
                            label.delete(lb)
                            array.remove(setup.targetLines, i)
                            array.remove(setup.targetLabels, i)
                        else
                            // Line is static — no extension needed
                            activeTargets += 1




// 5. Handle Setup History Limit
while array.size(activeSetups) > historyCount
    oldSetup = array.shift(activeSetups)
    line.delete(oldSetup.levelLine)
    label.delete(oldSetup.levelLabel)
    box.delete(oldSetup.breakerBox)
    if not na(oldSetup.fvgBox)
        box.delete(oldSetup.fvgBox)
    label.delete(oldSetup.setupLabel)
    for l in oldSetup.targetLines
        line.delete(l)
    for lb in oldSetup.targetLabels
        label.delete(lb)

// ========================================
// POTENTIAL BREAKER ALERT (ON UNCONFIRMED BAR)
// ========================================
var int lastPotentialAlertBar = na
if alertPotential and barstate.isrealtime and not barstate.isconfirmed and bar_index != lastPotentialAlertBar
    if not na(pendingBullSweepIdx)
        sweepOffset = bar_index - pendingBullSweepIdx
        [startOff, endOff] = f_findUpCandlesSeries(sweepOffset)
        if not na(startOff)
            [bTop, bBtm] = f_getSeriesRange(startOff, endOff)
            if close > bTop and bBtm >= pendingBullSweepExtreme
                alert("Potential Breaker: Potential Bullish Breaker forming on " + syminfo.ticker, alert.freq_once_per_bar)
                lastPotentialAlertBar := bar_index

    if not na(pendingBearSweepIdx)
        sweepOffset = bar_index - pendingBearSweepIdx
        [startOff, endOff] = f_findDownCandlesSeries(sweepOffset)
        if not na(startOff)
            [bTop, bBtm] = f_getSeriesRange(startOff, endOff)
            if close < bBtm and bTop <= pendingBearSweepExtreme
                alert("Potential Breaker: Potential Bearish Breaker forming on " + syminfo.ticker, alert.freq_once_per_bar)
                lastPotentialAlertBar := bar_index

// ========================================
// DASHBOARD RENDERING & DYNAMIC INVAL SYNC
// ========================================

// Extract latest active (non-invalidated, non-target hit) setup details dynamically
string showSetupDir = "NONE"
float showEntryPrice = na
float showInvalidationPrice = na
float showTargetPrice = na
float showRiskUsd = na
float showPositionSizeVal = na

if array.size(activeSetups) > 0
    for i = array.size(activeSetups) - 1 to 0
        s = array.get(activeSetups, i)
        if not s.isInvalidated and not s.isTargetHit
            showSetupDir := s.dir == "BULL" ? "BULLISH" : "BEARISH"
            showEntryPrice := s.entryPrice
            showInvalidationPrice := s.invalidationPrice
            if array.size(s.targetLines) > 0
                showTargetPrice := line.get_y1(array.get(s.targetLines, 0))
            else
                showTargetPrice := s.entryPrice + (s.dir == "BULL" ? 1 : -1) * rrRatio * math.abs(s.entryPrice - s.invalidationPrice)

            showRiskUsd := riskType == "Percentage" ? (accountBalance * riskAmount / 100.0) : riskAmount
            showPositionSizeVal := calculatePositionSize(showEntryPrice, showInvalidationPrice, showRiskUsd)
            break

var table dashboardTable = table.new(
     position = f_getTablePosition(dashboardPosition),
     columns = 3,
     rows = 14,
     bgcolor = tableBgColor,
     border_width = tableBorderWidth,
     border_color = tableBorderColor,
     frame_color = tableFrameColor,
     frame_width = tableFrameWidth
     )

if barstate.islast and showDashboard
    tSize = f_getTableTextSize(dashboardSize)

    // Header
    table.cell(dashboardTable, 0, 0, "Unicorn Model", bgcolor=tableHeaderBgColor, text_color=tableHeaderTextColor, text_size=tSize, text_font_family=font.family_monospace)
    table.merge_cells(dashboardTable, 0, 0, 2, 0)

    // Stats Rows
    table.cell(dashboardTable, 0, 1, "Bias:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
    table.cell(dashboardTable, 1, 1, biasSelect, text_color=biasSelect == "Neutral" ? color.orange : (biasSelect == "Bullish" ? color.green : color.red), text_size=tSize, text_font_family=font.family_monospace)
    table.cell(dashboardTable, 2, 1, "", text_size=tSize)

    table.cell(dashboardTable, 0, 2, "Unicorn Mode:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
    table.cell(dashboardTable, 1, 2, unicornMode ? "ENABLED" : "DISABLED", text_color=unicornMode ? color.green : color.gray, text_size=tSize, text_font_family=font.family_monospace)
    table.cell(dashboardTable, 2, 2, "", text_size=tSize)

    table.cell(dashboardTable, 0, 3, "Liquidity Source:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
    activeSrcs = ""
    if useA_resolved
        activeSrcs := activeSrcs + "A "
    if useB_resolved
        activeSrcs := activeSrcs + "B "
    if useC_resolved
        activeSrcs := activeSrcs + "C "
    if useD_resolved
        activeSrcs := activeSrcs + "D "
    table.cell(dashboardTable, 1, 3, activeSrcs, text_color=color.orange, text_size=tSize, text_font_family=font.family_monospace)
    table.cell(dashboardTable, 2, 3, "(" + htfMode + ")", text_color=color.gray, text_size=tSize, text_font_family=font.family_monospace)

    table.cell(dashboardTable, 0, 4, "Invalidation:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
    table.cell(dashboardTable, 1, 4, useSwingInvalidation ? "Swing Extreme" : "Breaker Extreme", text_color=color.orange, text_size=tSize, text_font_family=font.family_monospace)
    table.cell(dashboardTable, 2, 4, "", text_size=tSize)

    table.cell(dashboardTable, 0, 5, "Size Filter:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
    filterDesc = sizeFilterMode == "Filtered" ? str.tostring(minBreakerSize) + "-" + str.tostring(maxBreakerSize) + " " + breakerSizeUnit : "DISABLED"
    table.cell(dashboardTable, 1, 5, filterDesc, text_color=sizeFilterMode == "Filtered" ? color.green : color.gray, text_size=tSize, text_font_family=font.family_monospace)
    table.cell(dashboardTable, 2, 5, "", text_size=tSize)

    table.cell(dashboardTable, 0, 6, "Time Filter:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
    table.cell(dashboardTable, 1, 6, enableTimeFilter ? "ENABLED" : "DISABLED", text_color=enableTimeFilter ? color.green : color.gray, text_size=tSize, text_font_family=font.family_monospace)
    table.cell(dashboardTable, 2, 6, "", text_size=tSize)

    // Latest Setup Section
    table.cell(dashboardTable, 0, 7, "── LATEST SETUP ──", bgcolor=tableHeaderBgColor, text_color=tableHeaderTextColor, text_size=tSize, text_font_family=font.family_monospace)
    table.merge_cells(dashboardTable, 0, 7, 2, 7)

    if showSetupDir != "NONE"
        table.cell(dashboardTable, 0, 8, "Direction:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
        table.cell(dashboardTable, 1, 8, showSetupDir, text_color=showSetupDir == "BULLISH" ? color.green : color.red, text_size=tSize, text_font_family=font.family_monospace)
        table.cell(dashboardTable, 2, 8, "", text_size=tSize)

        table.cell(dashboardTable, 0, 9, "Entry Price:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
        table.cell(dashboardTable, 1, 9, str.tostring(showEntryPrice, format.mintick), text_color=tableTextColor, text_size=tSize, text_font_family=font.family_monospace)
        table.cell(dashboardTable, 2, 9, "", text_size=tSize)

        table.cell(dashboardTable, 0, 10, "Invalidation:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
        table.cell(dashboardTable, 1, 10, str.tostring(showInvalidationPrice, format.mintick), text_color=color.red, text_size=tSize, text_font_family=font.family_monospace)
        table.cell(dashboardTable, 2, 10, "", text_size=tSize)

        table.cell(dashboardTable, 0, 11, "Target (" + str.tostring(rrRatio, "#.##") + "R):", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
        table.cell(dashboardTable, 1, 11, str.tostring(showTargetPrice, format.mintick), text_color=color.green, text_size=tSize, text_font_family=font.family_monospace)
        table.cell(dashboardTable, 2, 11, "", text_size=tSize)

        if showPositionSize and not na(showPositionSizeVal)
            table.cell(dashboardTable, 0, 12, "Size:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
            table.cell(dashboardTable, 1, 12, formatPositionSize(showPositionSizeVal), text_color=color.aqua, text_size=tSize, text_font_family=font.family_monospace)
            table.cell(dashboardTable, 2, 12, "", text_size=tSize)
        else
            table.cell(dashboardTable, 0, 12, "", text_size=tSize)
            table.cell(dashboardTable, 1, 12, "", text_size=tSize)
            table.cell(dashboardTable, 2, 12, "", text_size=tSize)
    else
        table.cell(dashboardTable, 0, 8, "No active setups detected.", text_color=color.gray, text_size=tSize, text_font_family=font.family_monospace)
        table.merge_cells(dashboardTable, 0, 8, 2, 8)
        for r = 9 to 12
            table.cell(dashboardTable, 0, r, "", text_size=tSize)
            table.merge_cells(dashboardTable, 0, r, 2, r)

    // ── HTF FVG context row (NEW) ──
    // Row 13 of the 14-row table, unused by the original dashboard. Nothing is
    // written here when the filter is off, so the table renders identically.
    //
    // This row sits under "LATEST SETUP", so while a setup is on the chart it
    // must describe *that setup* — it reports whether the setup itself was
    // qualified, never the opposite direction's context, which is irrelevant to
    // it by definition. Only with no active setup does it fall back to showing
    // live context, where there is no setup for it to be misread against.
    if enableHtfFvg
        // Mirrors the latest-setup extraction above (same order, same
        // conditions, same break) so it always resolves to the same setup.
        int    latestConf = na
        string latestDir  = ""
        if array.size(activeSetups) > 0
            for i = array.size(activeSetups) - 1 to 0
                s = array.get(activeSetups, i)
                if not s.isInvalidated and not s.isTargetHit
                    latestConf := s.confIndex
                    latestDir  := s.dir
                    break

        string ctxTxt = "NONE"
        color  ctxCol = color.gray
        if not na(latestConf)
            // Matched on confirmation bar AND direction: a qualified setup in
            // one direction can never light up a setup in the other.
            if not na(lastQualBar) and lastQualBar == latestConf and lastQualDir == latestDir
                ctxTxt := "QUALIFIED " + lastQualTf
                ctxCol := latestDir == "BULL" ? color.green : color.red
            else
                ctxTxt := "NOT QUALIFIED"
                ctxCol := color.gray
        else if bullHtfContext and bearHtfContext
            ctxTxt := "BULL + BEAR"
            ctxCol := color.orange
        else if bullHtfContext
            ctxTxt := "BULL " + lastBullTapTf + " (" + str.tostring(bar_index - lastBullTapBar) + "b)"
            ctxCol := color.green
        else if bearHtfContext
            ctxTxt := "BEAR " + lastBearTapTf + " (" + str.tostring(bar_index - lastBearTapBar) + "b)"
            ctxCol := color.red
        table.cell(dashboardTable, 0, 13, "HTF FVG Context:", text_color=tableTextColor, text_size=tSize, text_halign=text.align_left, text_font_family=font.family_monospace)
        table.cell(dashboardTable, 1, 13, ctxTxt, text_color=ctxCol, text_size=tSize, text_font_family=font.family_monospace)
        table.cell(dashboardTable, 2, 13, str.tostring(htfFvgWindow) + "b", text_color=color.gray, text_size=tSize, text_font_family=font.family_monospace)

// ========================================
// QUALIFIED UNICORN RENDERING & ALERTS (NEW)
// ========================================
// plotshape/plotchar are used rather than label.new so the new markers cost
// nothing against the label and box budgets the Unicorn engine draws into, and
// so a historical marker is fixed to its own bar and cannot migrate.
plotshape(showQualifiedMarkers and qualifiedBullSignal, title="Qualified Bullish Unicorn", style=shape.diamond, location=location.belowbar, color=#089981, size=size.tiny)
plotshape(showQualifiedMarkers and qualifiedBearSignal, title="Qualified Bearish Unicorn", style=shape.diamond, location=location.abovebar, color=#f23645, size=size.tiny)

plotchar(showTapMarkers and bullEnter, title="Bullish HTF FVG Tap", char="▲", location=location.belowbar, color=color.new(#089981, 45), size=size.tiny)
plotchar(showTapMarkers and bearEnter, title="Bearish HTF FVG Tap", char="▼", location=location.abovebar, color=color.new(#f23645, 45), size=size.tiny)

alertcondition(qualifiedBullSignal, "Qualified Bullish Unicorn", "{{ticker}} ({{interval}}): Qualified Bullish Unicorn — bullish HTF FVG tapped, then a bullish Unicorn confirmed inside the interaction window")
alertcondition(qualifiedBearSignal, "Qualified Bearish Unicorn", "{{ticker}} ({{interval}}): Qualified Bearish Unicorn — bearish HTF FVG tapped, then a bearish Unicorn confirmed inside the interaction window")

alertcondition(bullEnter, "Price entered Bullish FVG", "{{ticker}} ({{interval}}): price entered a bullish FVG")
alertcondition(bearEnter, "Price entered Bearish FVG", "{{ticker}} ({{interval}}): price entered a bearish FVG")
