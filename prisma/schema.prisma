// Trader Dashboard — Prisma schema
// SQLite datasource, see prisma.config.ts for connection config

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------- Prop Firm accounts ----------

model PropFirmAccount {
  id          String   @id @default(cuid())
  firmName    String
  accountName String
  accountType String // "eval" | "funded"
  status      String   @default("active") // "active" | "passed" | "failed" | "closed"
  createdAt   DateTime @default(now())

  startingBalance  Float?
  maxDrawdownLimit Float? // $ trailing/static max drawdown allowed by the firm
  dailyLossLimit   Float? // $ max loss allowed in a single day

  trades   Trade[]
  expenses AccountExpense[]
  payouts  AccountPayout[]
}

model AccountExpense {
  id        String   @id @default(cuid())
  accountId String
  account   PropFirmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind      String // "evaluation_fee" | "recurring_fee"
  amount    Float
  date      DateTime
  note      String?
  createdAt DateTime @default(now())
}

model AccountPayout {
  id        String   @id @default(cuid())
  accountId String
  account   PropFirmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount    Float
  date      DateTime
  note      String?
  createdAt DateTime @default(now())
}

// ---------- Daily journal ----------

model TradingDay {
  id        String   @id @default(cuid())
  date      DateTime @unique

  // Pre-market plan
  htfBias           String?
  keyLevels         String?
  sessionTiming     String?
  news              String?
  maxLossPlan       Float?
  positionSizePlan  String?
  maxTradeCountPlan Int?
  preMarketChecklist String? // JSON-serialized PreMarketChecklist

  // Post-session review
  planAdherenceGrade String? // "A+" | "A" | "B" | "C"
  psychologyLog      String?
  freeformNotes      String?
  scorecard          String? // JSON-serialized ScorecardScores

  // Live Session cockpit
  emergencyPauseUntil DateTime? // set by the crashout button; compared against now() at read time, no cleanup job
  sessionEndedAt      DateTime? // null = session open; set = Quick Log locked, Daily Recap available
  profitLockPlan      Float?    // Today's Mission "profit lock" target
  missionLabel        String?   // free-text mission tagline; null renders a default ("Trade the Plan") in code
  debriefImprovement  String?   // Daily Recap debrief: "What to improve tomorrow"
  debriefFeeling      String?   // Daily Recap debrief: "How I actually felt" — kept distinct from psychologyLog

  // Setup Grader session
  graderBias String? // "bullish" | "bearish" | "neutral" — Setup Grader's daily bias picker

  // AI
  aiSummary String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trades             Trade[]
  missedTrades       MissedTrade[]
  ruleViolations     RuleViolationChecklistItem[]
  planScreenshots    TradingDayScreenshot[]
  graderNotes        SetupGraderNote[]
}

model SetupGraderNote {
  id           String   @id @default(cuid())
  tradingDayId String
  tradingDay   TradingDay @relation(fields: [tradingDayId], references: [id], onDelete: Cascade)
  text         String
  createdAt    DateTime @default(now())
}

model TradingDayScreenshot {
  id           String   @id @default(cuid())
  tradingDayId String
  tradingDay   TradingDay @relation(fields: [tradingDayId], references: [id], onDelete: Cascade)
  filePath     String
  kind         String? // "daily" | "htf4h" | "mtf15m" — null = generic/unlabeled plan screenshot

  createdAt DateTime @default(now())
}

model RuleViolationChecklistItem {
  id     String  @id @default(cuid())
  label  String  @unique
  active Boolean @default(true)

  tradingDays TradingDay[]
}

// ---------- Trades ----------

model Trade {
  id           String   @id @default(cuid())
  tradingDayId String
  tradingDay   TradingDay @relation(fields: [tradingDayId], references: [id], onDelete: Cascade)
  accountId    String?
  account      PropFirmAccount? @relation(fields: [accountId], references: [id])

  symbol    String
  direction String // "long" | "short"

  entryPrice Float
  exitPrice  Float?
  entryTime  DateTime
  exitTime   DateTime?

  stopLossPlanned Float?
  stopLossActual  Float?
  targetPlanned   Float?
  targetActual    Float?

  positionSize Int

  grossPnl Float?
  commission Float?
  netPnl   Float?
  rMultiple Float?

  htfChartLink          String? // TradingView chart link for the HTF read
  intermediateChartLink String? // TradingView chart link for the intermediate/context timeframe
  entryChartLink        String? // TradingView chart link for the entry/execution timeframe
  entryTimeframe        String? // e.g. "1m" | "5m" | "15m" — drives the Analytics "by entry timeframe" breakdown

  entryModel String?
  session    String?
  setupGrade String? // "A+" | "A" | "B" | "C"

  dailyBias String?
  htfPoi    String?
  htfDol    String?

  setupFactorsChecklist String? // JSON: SetupFactorsChecklist — the Unicorn Model criteria checklist

  mfeR Float? // max favorable excursion reached before exit, in R-multiples
  maeR Float? // max adverse excursion reached before exit, in R-multiples

  writeup String?

  smartReview String? // JSON: { summary, setup, execution, psychology } — AI-generated per-trade review
  reviewed    Boolean @default(false)
  quickLogged Boolean @default(false) // true = created via Live Session Quick Log, still needs fleshing out (placeholder entry/size)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  confluenceFactors ConfluenceFactor[] @relation("TradeConfluenceFactors")
  mistakes          MistakeType[]      @relation("TradeMistakes")
  screenshots       Screenshot[]
  tags              TagOption[]        @relation("TradeTags")
}

model MissedTrade {
  id           String   @id @default(cuid())
  tradingDayId String
  tradingDay   TradingDay @relation(fields: [tradingDayId], references: [id], onDelete: Cascade)

  symbol           String
  setupDescription String?
  reasonMissed     String?
  entryModel       String?
  session          String?
  estimatedRMultiple Float? // user's estimate of the outcome had the trade been taken, in R

  createdAt DateTime @default(now())

  confluenceFactors ConfluenceFactor[] @relation("MissedTradeConfluenceFactors")
  tags              TagOption[]        @relation("MissedTradeTags")
}

model Screenshot {
  id       String @id @default(cuid())
  tradeId  String
  trade    Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  filePath String

  createdAt DateTime @default(now())
}

// ---------- Editable ICT taxonomy lookups ----------

model ConfluenceFactor {
  id     String  @id @default(cuid())
  label  String  @unique
  active Boolean @default(true)

  trades       Trade[]       @relation("TradeConfluenceFactors")
  missedTrades MissedTrade[] @relation("MissedTradeConfluenceFactors")
}

model EntryModel {
  id     String  @id @default(cuid())
  label  String  @unique
  active Boolean @default(true)
}

model TradeSession {
  id     String  @id @default(cuid())
  label  String  @unique
  active Boolean @default(true)
}

model MistakeType {
  id     String  @id @default(cuid())
  label  String  @unique
  active Boolean @default(true)

  trades Trade[] @relation("TradeMistakes")
}

// ---------- Trade tagging engine (Entry/Exit/Management/psychology tags) ----------
// User-extensible categories, each holding a small set of sentiment-tagged options.
// "One tag per category per trade" is enforced in the save action, not the DB.

model TagCategory {
  id     String  @id @default(cuid())
  name   String  @unique
  order  Int     @default(0)
  active Boolean @default(true)

  tags TagOption[]
}

model TagOption {
  id         String      @id @default(cuid())
  categoryId String
  category   TagCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  label      String
  sentiment  String // "positive" | "neutral" | "negative"
  active     Boolean     @default(true)

  trades       Trade[]       @relation("TradeTags")
  missedTrades MissedTrade[] @relation("MissedTradeTags")

  @@unique([categoryId, label])
}

// ---------- Goals ----------

model Goal {
  id          String   @id @default(cuid())
  tier        String // "weekly" | "monthly" | "yearly"
  targetAmount Float
  periodStart DateTime
  periodEnd   DateTime

  createdAt DateTime @default(now())
}

model ProcessGoal {
  id          String   @id @default(cuid())
  label       String
  metric      String // "journaling_days" | "discipline_score" | "zero_violation_days" | "clean_setup_days"
  targetValue Float
  periodStart DateTime
  periodEnd   DateTime

  createdAt DateTime @default(now())
}

// ---------- Coach layer ----------

model Tendency {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("watching") // "watching" | "resolved" | "eliminated"
  seenCount   Int       @default(0)
  lastSeenAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- To-Do ----------

model TodoItem {
  id          String    @id @default(cuid())
  title       String
  notes       String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Daily Schedule / Habit Tracker ----------

model Habit {
  id      String  @id @default(cuid())
  label   String  @unique
  cadence String  @default("daily") // "daily" | "weekday" — which days count toward its streak
  order   Int     @default(0)
  active  Boolean @default(true)

  createdAt DateTime @default(now())

  logs HabitLog[]
}

model HabitLog {
  id      String @id @default(cuid())
  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date    DateTime // normalized to local midnight, same convention as TradingDay.date

  createdAt DateTime @default(now())

  @@unique([habitId, date])
}

// ---------- Life Goals (Business / Personal) ----------

model LifeGoal {
  id           String    @id @default(cuid())
  category     String // "business" | "personal"
  tier         String? // "daily" | "weekly" | "monthly" | "quarterly" | "annual" — optional, purely for filtering
  title        String
  description  String?
  isPrimary    Boolean   @default(false)
  targetValue  Float?
  currentValue Float     @default(0)
  unit         String?
  direction    String    @default("increase") // "increase" | "limit"
  targetDate   DateTime?
  achieved     Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Periodic Reviews ----------

model PeriodReview {
  id          String   @id @default(cuid())
  title       String
  rating      Int? // 1-5
  periodStart DateTime
  periodEnd   DateTime
  periodType  String? // "week" | "month" | "quarter" | "year" | "custom" — drives which template sections render; null = legacy row, treated as rolled-up
  category    String? // free text w/ suggestions ("Discipline", "Performance", "Psychology", ...)
  notes       String?
  isDraft     Boolean  @default(false)

  // Weekly-only self-assessment sections (JSON, all nullable)
  processScore         String? // JSON ProcessScoreScores — {preparation,execution,discipline,emotionalControl} 1-10
  confidenceScores      String? // JSON ConfidenceScores — {preparation,execution,psychology,patience,risk,consistency,overall} 1-10
  decisionQualityScore  String? // JSON DecisionQualityScore — {preparation:0-20,htfBias:0-15,setup:0-20,entry:0-20,risk:0-15,emotionalControl:0-10}
  tradeBreakdown         String? // JSON Record<tradeId, {whatWentWell,improvements,executionScore,confidenceScore}> — weekly only
  opportunityReview      String? // JSON {narrative} — missed A+ setups in period; weekly only
  screenshotReview       String? // JSON {bestTradeId,bestTradeScreenshotId,worstTradeId,worstTradeScreenshotId,bestMissedSetupNote,biggestMistakeTradeId,biggestMistakeScreenshotId} — weekly only

  // Sections available at every period type (week + rolled-up)
  mistakeTracker         String? // JSON {costliestMistakeLabel,narrative}
  ruleViolationsSummary  String? // JSON {narrative}
  patternRecognition     String? // JSON {narrative}
  lessonsLearned         String? // JSON string[] (up to 3)
  actionItems            String? // JSON string[] (up to 3)
  playbookUpdate         String? // JSON {notes} — pure user text, never AI-drafted
  periodGrade            String? // JSON {scores:{preparation,analysis,execution,riskManagement,psychology,consistency,overall} 1-10, aiSuggestion:{tone,assessment}|null}
  ceoQuestions           String? // JSON {mostProfit,mostCost,repeatingPattern,oneHabit,satisfiedIfIdentical}

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Macro briefing (AI + web search) ----------

model MacroBriefing {
  id        String   @id @default(cuid())
  date      DateTime @unique // trading day this briefing is "as of"
  asOf      String? // human-readable freshness label, e.g. "Wed, overnight"
  macroTone String // AI-written paragraph(s) on overnight/macro tone

  economicCalendarToday String // JSON: EconomicCalendarEvent[]
  weekAhead             String // JSON: WeekAheadDay[]
  trumpAppearancesToday String @default("[]") // JSON: TrumpAppearance[]

  createdAt DateTime @default(now())
}

// ---------- AI Pre-Market Analyst (ICT Unicorn Model) ----------

model PreMarketAnalysis {
  id         String   @id @default(cuid())
  date       DateTime
  instrument String // "NQ" | "ES"

  // Call 1 — raw ICT read (vision)
  htfBiasAnalysis   String // JSON: structure, swings, prem/disc, opens, PDH/PDL, DOL, HTF FVGs, order flow
  htfBiasConfidence Float
  liquidityAnalysis String // JSON: buy/sell-side, equal H/L, internal/external, sweeps, stop hunts, ERL/IRL narrative
  fvgAnalysis       String // JSON: { oneHour: FvgEntry[]; fifteenMinute: FvgEntry[] }, each ranked + alignsWithHtfBias

  premiumDiscountZone  String // "premium" | "discount" | "equilibrium"
  premiumDiscountNotes String

  // Call 2 — Daily Bias Engine + Trade Plan synthesis (text-only)
  bullishPct Float
  bearishPct Float
  rangePct   Float // normalized in app code to sum to exactly 100

  overallBias       String // "bullish" | "bearish" | "range"
  biasConfidence    Float
  biasReasoning     String
  expectedNarrative String
  invalidationLevel String // free text — vision-read approximation, not tick-precise
  primaryTarget     String
  secondaryTarget   String

  tradeable     Boolean
  noTradeReason String?

  tradeScenarios String // JSON: exactly 3 scenarios (A/Bullish, B/Bearish, C/Range)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  screenshots PreMarketScreenshot[]
  review      PreMarketReview?

  @@unique([date, instrument])
}

model PreMarketScreenshot {
  id         String            @id @default(cuid())
  analysisId String
  analysis   PreMarketAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  instrument String
  timeframe  String // "1h" | "15m" | "1m"
  phase      String // "morning" | "eod"
  filePath   String

  createdAt DateTime @default(now())
}

model PreMarketReview {
  id         String            @id @default(cuid())
  analysisId String            @unique
  analysis   PreMarketAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  actualPriceActionSummary String

  // Learning System — five rolling accuracy dimensions
  biasCorrect           Boolean
  biasAccuracyScore      Float // 0-100
  biasNotes               String
  liquidityAccuracyScore Float
  liquidityNotes          String
  fvgAccuracyScore       Float
  fvgNotes                String
  targetAccuracyScore    Float
  targetNotes              String
  narrativeAccuracyScore Float
  narrativeNotes           String

  overallAccuracyScore Float
  overallSummary       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TradingViewLayout {
  id         String @id @default(cuid())
  instrument String // "NQ" | "ES"
  timeframe  String // "1h" | "15m" | "1m"
  url        String

  @@unique([instrument, timeframe])
}

// ---------- Notebook ----------

model NotebookEntry {
  id        String   @id @default(cuid())
  date      DateTime @unique
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Notebook folders (flat, one level — separate from daily NotebookEntry) ----------

model NotebookFolder {
  id        String   @id @default(cuid())
  name      String
  color     String? // palette key from src/lib/domain/notebook-colors.ts, e.g. "rose"
  order     Int      @default(0)
  createdAt DateTime @default(now())

  notes NotebookNote[]
}

model NotebookNote {
  id        String   @id @default(cuid())
  folderId  String
  folder    NotebookFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  title     String   @default("Untitled")
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Chart Vault ----------

model ChartImage {
  id       String  @id @default(cuid())
  filePath String
  title    String?
  symbol   String?
  grade    String? // "A+" | "A" | "B" | "C" | "D" | "F"
  notes    String?

  createdAt DateTime @default(now())
}

// ---------- Config ----------

model InstrumentConfig {
  id         String @id @default(cuid())
  symbol     String @unique
  tickValue  Float
  tickSize   Float
  pointValue Float?
}

model AppSettings {
  id              Int     @id @default(1)
  timezone        String  @default("America/New_York")
  anthropicApiKey String?
  cooldownMinutes Int     @default(5) // Live Session: minutes between trades before the cooldown timer is considered active
}
